  ALERT_NO_SPECIAL_HOURS: 30,  // همان، برای پادکست تخصصی
  ALERT_SYNC_BEHIND: 2000,     // اگر همگام‌سازی این‌قدر ردیف عقب افتاد، هشدار بده

  // ---- دیدبانی خودِ شیت‌های منبع ----
  // آستانهٔ «راکد» و «کم‌کار» ثابت نیست: از فاصلهٔ معمولِ خودِ همان تب حساب
