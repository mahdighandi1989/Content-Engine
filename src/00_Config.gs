  YT_ENABLED: true,
  YT_TAB: 'انتشار در یوتیوب',
  // اول unlisted، بعد وارسیِ نشتیِ خصوصی، و تازه بعدش عمومی. فاصله‌اش چند
  // ثانیه است، ولی معنایش این است که یک لینکِ درایو هرگز عمومی نمی‌شود.
  YT_PRIVACY_FIRST: 'unlisted',
  YT_PRIVACY_FINAL: 'public',
  YT_CATEGORY_VARIETY: '22',            // People & Blogs
  YT_CATEGORY_SPECIAL: '27',            // Education
  YT_LANG: 'fa',
  YT_TITLE_MAX: 100,                    // سقفِ خودِ یوتیوب
  YT_DESC_MAX: 5000,                    // سقفِ خودِ یوتیوب
  YT_TAGS_CHARS: 460,                   // سقفِ واقعی ۵۰۰ است؛ حاشیه می‌گذاریم
  /* سه در شب + یکی در دورِ ۱۰ صبح = چهار در روز. سقفِ واقعی پنج است
