     اوکی بودن … همه متن‌ها نشانه‌گذاری بشن، حالت‌ها توجیه بشن، و ثبت بشن …
     نه فقط برای این گوینده‌ها، حتی برای گوینده‌های فعلی». پس در **هر** قسمتِ
     هر دو برنامه روشن است، با هر گوینده‌ای. جای حالت‌ها یک بار در مرحلهٔ
     متن (`speak2`) از معنای متن گرفته و در پروندهٔ قسمت ذخیره می‌شود
     (`speakMoodsStep_`)؛ صداسازی فقط همان را می‌خوانَد، چون هرچه در
     ازسرگیری دوباره پرسیده شود شمارهٔ تکه‌ها را جابه‌جا می‌کند. خاموش کردنش
     همان لحظه اثر دارد: نقشهٔ ذخیره‌شده دیگر خوانده نمی‌شود. */
  SPEAK_SPANS: true,
  SPEAK_SPANS_EP: true,
  /* در قسمت، سقفِ حالت از طولِ متن می‌آید نه یک عدد: یک حالت برای هر چند
     جمله (سقف است، نه هدف — پرامپت می‌گوید بیشترِ جمله‌ها بی‌حالت‌اند). */
  SPEAK_SPAN_EP_EVERY: 10,
  SPEAK_SPAN_EP_BLOCK: 120,   // جمله‌های یک پرسش؛ قسمتِ بلندتر چند پرسش است
  SPEAK_SPAN_EP_MIN: 6,       // بندِ کوتاه‌تر از این حالت نمی‌گیرد
  SPEAK_SPAN_TRY_MAX: 2,      // پرسشِ ناموفق چند بار تا «رهاشده» (با علت)
  /* ══ ۸.۴۱ ══
     فایلِ خوانای «حالت‌ها و نشانه‌ها» کنارِ «متن صوتی» در پوشهٔ هر قسمت: هر
     حالت با ثانیه، جمله، «چرا»ی مدل و «چطور» ساخته شد. */
  SPEAK_MOOD_FILE: true,
  /* سبکِ مکثِ گوینده روی کلِ خوانش: هر مکثی که گفتارساز گذاشته و از اندازهٔ
     کارتِ گوینده کوتاه‌تر است، با سکوتِ واقعی کشیده می‌شود (هرگز کوتاه
     نمی‌شود، مکثِ تازه ساخته نمی‌شود). بی کارت هیچ اثری ندارد. */
  SPEAK_STYLE_GAPS: true,
  SPEAK_STYLE_GAP_CAP: 0.25,  // سقفِ سکوتِ افزوده در هر تکه، نسبت به طولِ آن
  SPEAK_STYLE_GAP_MIN_F: 12,  // کوتاه‌ترین سکوتی که «مکث» شمرده می‌شود (×۱۰ میلی‌ثانیه)
  SPEAK_SPAN_MAX: 10,        // بیشترین حالت در یک متن (مکث هم یکی است)
  SPEAK_SPAN_SENT_MAX: 3,    // یک حالت حداکثر چند جملهٔ پشتِ‌هم
  SPEAK_SPAN_SENTS: 160,     // متنِ بلندتر از این، فقط تا همین‌جا حالت می‌گیرد
  SPEAK_PAUSE_SEC: 0.9,
  MUSIC_HEAR_TRY_MAX: 4,
  /* ══ نسخهٔ «شنیدن» (۸.۳۲) ══
     تا ۸.۳۱ `musicListen_` با سقفِ ۴۸ توکن می‌پرسید و مدلِ «فکرکننده» همان
     ۴۸ را صرفِ فکر می‌کرد: پاسخ خالی، «مدل نشنید»، و پس از چهار بار قطعه
     برای همیشه از صفِ شبانه بیرون. یعنی آن چهار «تلاش» هرگز تلاش نبودند.
     تلاش‌ها فقط وقتی شمرده می‌شوند که با همین نسخه انجام شده باشند؛ عوض
     کردنِ این عدد صفِ شبانه را یک بار برای همهٔ قطعه‌ها از نو باز می‌کند —
     همان شکلِ `EMB_TEXT_VER` (۷.۲۷)، چون «پاک‌کردنِ ورودی آنچه را نوشته شده
     درست نمی‌کند» (۵.۹۵). */
  MUSIC_HEAR_VER: 2,
  /* و سقفِ انباشت: بیش از این قطعهٔ شنیده‌نشده، **دیگر قطعهٔ تازه نمی‌آوریم**.
     آوردنِ چیزی که نمی‌توانیم استفاده کنیم فقط عدد را بدتر می‌کند — و همان
     بود که در یک شب ۶ تا اضافه کرد در حالی که صفر تا شنیده شد. */
  MUSIC_UNHEARD_STOP: 25,

  // ── چرخشِ بانک: گشتن هرگز نباید بایستد ──
  // تا ۵٫۶۴ لحظه‌ای که پوششِ خانواده‌ها کامل می‌شد، musicThinSlots_ خالی
  // برمی‌گشت و در کارِ شبانه musicSeek_ دیگر هرگز صدا زده نمی‌شد. یعنی بانک
  // برای همیشه منجمد می‌شد: همان قطعه‌ها تا ابد، هرچند بار هم پخش شده باشند.
  // «بارِ استفاده» ثبت می‌شد و در تبِ تاریخچه هم می‌نشست، ولی به گشتن وصل
  // نبود — یک اندازه‌گیریِ دیگر که هیچ تصمیمی بر آن سوار نشده بود.
  //
  // حالا وقتی کمبودی نیست، خانوادهٔ *فرسوده* هدف می‌شود: خانواده‌ای که همهٔ
  // قطعه‌هایش دستِ‌کم MUSIC_ROTATE_USED بار پخش شده‌اند.
  MUSIC_ROTATE: true,
  MUSIC_ROTATE_USED: 4,       // قطعه‌ای که این‌قدر پخش شده «فرسوده» است
  MUSIC_ROTATE_SLOTS: 1,      // شبی که کمبودی نیست، فقط این تعداد جایگاه
  MUSIC_BANK_MAX: 90,         // سقفِ مطلقِ بانک — رشدِ بی‌پایان هم درست نیست
  // اشباعِ امتیازِ «کم‌مصرف‌تر جلوتر». تا ۵٫۶۴ عددش ۵ بود، پس وقتی همهٔ
  // قطعه‌ها پنج بار پخش می‌شدند این معیار از کار می‌افتاد و نوبت‌دهی کور
  // می‌شد — دقیقاً همان‌جا که تازه لازم می‌شد.
  MUSIC_USED_CAP: 12,
  // چرخش با همان واژه‌های جست‌وجو نتیجهٔ تازه نمی‌دهد: archive.org همان
  // ۲۵ نتیجهٔ اول را می‌دهد و همه‌شان قبلاً دیده شده‌اند. پس صفحه می‌چرخد.
  MUSIC_SEEK_PAGES: 5,
  // دانلود در کارِ شبانه جا دارد ولی مهلتِ شش‌دقیقه‌ای گوگل هم هست. به‌جای
  // یک سقفِ ثابتِ محافظه‌کارانه، سقفِ زمانی: تا وقتی وقت هست بیاور.
  MUSIC_FETCH_BUDGET_MS: 150000,
  // سهمِ کلِ کارِ شبانه از مهلتِ شش‌دقیقه‌ایِ گوگل. هر کارِ سنگین پیش از
  // شروع می‌پرسد وقت مانده یا نه؛ نمانده باشد، صریح گزارش می‌شود و فردا
  // شب نوبتش می‌رسد — به‌جای اینکه اجرا وسطِ کار بی‌صدا کشته شود و هرچه
  // بعد از آن بود (از جمله نصبِ کد) اصلاً اجرا نشود.
  NIGHT_BUDGET_MS: 270000,
  /* ══ چند شب گرسنگی، تا کاری «نوبت‌دار» شود (۶٫۸۹) ══
     بلوک‌های سنگینِ شبانه به ترتیبِ اهمیت‌اند و آخری‌ها با بودجهٔ ۲۷۰
     ثانیه‌ای هرگز نوبت نمی‌گیرند. `bridgeAuditRun_` یازدهمی بود و در
     گزارشِ ۳ سپتامبر: «هیچ ارجاعی تا امروز داوری نشده». */
  NIGHT_STARVE_NIGHTS: 3,
  // سهمی که برای کارِ گرسنه کنار گذاشته می‌شود، حداکثر چه کسری از بودجه
  /* از ۶٫۹۷ کارِ شبانه در چند اجرا تمام می‌شود، نه در یکی. سقف هست چون
     حلقه‌ای که خودش خودش را زمان‌بندی می‌کند، اگر گیر کند تا ابد می‌دود —
     و رسیدن به سقف خودش خبر است. */
  NIGHT_MAX_RUNS: 8,
  NIGHT_CONTINUE_MS: 60000,
  // بودجهٔ وارسیِ سلامت. گوگل در شش دقیقه بی‌خطا می‌کشد؛ این عدد جا
  // می‌گذارد تا مُهر و ایمیل — که در انتهای تابع‌اند — همیشه برسند.
  HEALTH_BUDGET_MS: 280000,
  /* چند روز کهنگیِ `health.checkedAt` یعنی «گزارشِ روزانه نرفت» (۷٫۶۳).
     ۲ است نه ۱: سرِ ۰۲:۳۰ هنوز وارسیِ امروز نیامده، پس مهرِ دیروز حالتِ
     سالم است. ۲ یعنی یک روزِ کامل گزارش نرفته. */
  HEALTH_STALE_DAYS: 2,
  MUSIC_SEEK_MIN_SEC: 5,             // کوتاه‌تر از این، قطعه نیست
  MUSIC_SEEK_API: 'https://archive.org',
  // فایلی که سنجه ردش می‌کند به این زیرپوشه می‌رود — پاک نمی‌شود.
  // قاعدهٔ ریپو: موتور چیزی را که خودش نساخته حذف نمی‌کند، و حتی چیزی
  // را که ساخته هم بی اطلاعِ صاحبِ برنامه پاک نمی‌کند.
  MUSIC_REJECT_FOLDER: 'کنارگذاشته — گفتار یا نامناسب',

  MUSE_TAB: 'کاربردِ موسیقی',   // تاریخچهٔ پخش: کدام قطعه، کدام قسمت، کدام جایگاه
  MUSIC_TAB: 'موسیقی',
  /* ── طولِ قطعه‌ها ──
     ۲۴ اوت، پس از نخستین قسمتِ واقعاً موسیقی‌دار: «موسیقیِ اول و گاهی وسط
     در حدِ یک ثانیه است، آخری پنج ثانیه… خیلی غیرحرفه‌ای.» درست بود، و سه
     علت داشت: شروعِ دیرهنگامِ بی‌وارسی که قطعه را می‌بُرید، محوی که کلِ
     قطعهٔ کوتاه را می‌خورد، و همین عددها که برای رادیو کوچک بودند. */
  MUSIC_INTRO_SEC: 14,          // طولِ موسیقیِ آغاز
  MUSIC_OUTRO_SEC: 20,         // طولِ موسیقیِ پایان (بسترِ زیرِ گفتار هم جزئش است)
  MUSIC_BRIDGE_SEC: 7,         // طولِ قطعهٔ میانه
  MUSIC_BRIDGE_EVERY: 4,            // (کهنه — از ۵٫۵۰ جای موسیقی از مرزِ بخش‌ها می‌آید)
  MUSIC_BRIDGE_MAX: 4,              // حداکثر قطعهٔ میانه در یک قسمت
  // و کف: تقریباً یک قطعهٔ میانه به‌ازای هر این تعداد مرزِ بخش. سقف تنها
  // کافی نبود — مدل معمولاً یکی پیشنهاد می‌دهد نه صفر، و پشتوانه فقط وقتی
  // کار می‌کرد که هیچ نداده باشد. پس سقف بالا می‌رفت و در عمل باز هم یک
  // قطعه پخش می‌شد. عدد را بالا ببرید تا موسیقی کمتر شود.
  MUSIC_BRIDGE_EVERY_SECTIONS: 2,
       // هر چند تکه یک میانه؛ صفر یعنی هیچ
  MUSIC_FADE_SEC: 3,           // محوِ نرمِ ابتدا و انتهای هر قطعه (شیبِ S از ۶٫۷۰)
  /* ── تلفیقِ لبه‌ها (۵٫۸۰) ──
     تکه‌ها پشتِ سرِ هم چسبانده می‌شدند: موسیقی تمام، بعد گوینده. صاحبِ
     برنامه: «یهو اون قطع شه و این شروع بشه… باید ثانیه‌های آخرِ موسیقی و
     ابتداییِ صدای گوینده کمی در هم تلفیق بشن.»
     حالا سرِ هر اتصالِ موسیقی↔گفتار، این تعداد ثانیه روی هم می‌افتد:
     یکی محو می‌شود و دیگری بالا می‌آید. */
  MUSIC_XFADE: true,
  MUSIC_XFADE_SEC: 1.8,        // پیش‌فرض، وقتی جایگاه عددِ خودش را ندارد
  /* ── و آنچه ۵٫۸۰ نداشت (۵٫۸۴) ──
     صاحبِ برنامه بعد از شنیدنِ قسمتِ ۱۸: «این حالتِ fade باز باید خیلی
     بهتر و حرفه‌ای‌تر انجام بشه؛ خیلی جای کار داره.» و درست بود — تلفیق
     وجود داشت ولی شکلش آماتوری بود:

     ۱) شیبِ خطی. دو صدای بی‌ربط با شیبِ خطی روی هم، وسطِ گذر ۶ دسی‌بل
        افت می‌کنند (توان با مجذورِ دامنه می‌رود، نه با خودش). گوش این را
        «یک چاله» می‌شنود. شیبِ هم‌توان (cos/sin) این چاله را می‌بندد.
     ۲) محوِ دوباره. خودِ قطعه از قبل با MUSIC_FADE_SEC (۲ ثانیه) محو
        می‌شد، و بعد تلفیق دوباره همان ناحیه را پایین می‌کشید — حاصلش
        ضربِ دو شیب بود، یعنی موسیقی خیلی زودتر از آنچه باید می‌مُرد.
        همان چیزی که شنیده می‌شد: «موسیقی می‌میرد، بعد گوینده می‌آید.»
     ۳) گوینده از صفر بالا می‌آمد؛ یعنی نخستین هجای هر بخش نامفهوم بود.
        حالا گوینده از کفِ MUSIC_DUCK_FLOOR وارد می‌شود و موسیقی زیرش
        می‌رود — این همان کاری است که در رادیو می‌کنند، و برعکسش نه.
     ۴) اگر یکی از دو طرف کوتاه بود، تلفیق بی‌صدا لغو می‌شد و همان‌جا
        بُرشِ خشک می‌ماند. حالا کوتاه می‌شود، نه لغو. */
  /* ── و آنچه ۵٫۸۴ هم نداشت (۶٫۷۰) ──
     صاحبِ برنامه، بعدِ شنیدنِ قسمت‌های موسیقی‌دار: «فید شدنش باید
     حرفه‌ای‌تر بشه و یهو قطع نشه؛ با شیبِ ملایم‌تری محو بشه — هم شروع،
     هم میانه‌ها. و پایان: از چند ثانیه قبل از آخرین جمله‌ها موسیقی با
     شیبِ ملایم شروع بشه و بعدش کم‌کم زیاد بشه.» سه چیز عوض شد:
     ۱) همهٔ شیب‌ها S شدند (xfRc_) — cos ساده در لحظهٔ صفر شیبِ تند دارد و
        لحظهٔ خاموشی «شنیده» می‌شود؛ S در هر دو سر شیبِ صفر دارد.
     ۲) هم‌پوشانی‌ها بلندتر شدند — شیبِ ملایم بی زمانِ کافی ممکن نیست.
     ۳) پایانِ قسمت «بستر» شد: موسیقی از MUSIC_OUTRO_UNDER_SEC ثانیه قبل از
        تمام‌شدنِ گفتار، کم‌صدا (MUSIC_OUTRO_BED) زیرش می‌نشیند و بعد از
        رفتنِ صدا در MUSIC_OUTRO_RISE_SEC ثانیه اوج می‌گیرد. شیبش در خودِ
        قطعه است (musicBedIn_)، نه در تلفیق — درسِ ۵٫۸۴ دربارهٔ ضربِ دو شیب. */
  MUSIC_XFADE_EDGE_SEC: 3.5,   // آغاز و پایانِ قسمت — جایی که وقت هست
  MUSIC_XFADE_BRIDGE_SEC: 2,   // میانه کوتاه‌تر است؛ ۳٫۵ کلش را می‌خورد
  MUSIC_XFADE_MIN_SEC: 0.15,   // کمتر از این، تلفیق نیست؛ تلنگر است
  MUSIC_OUTRO_UNDER_SEC: 6,    // بسترِ پایانی: چند ثانیه زیرِ آخرین جمله‌ها
  MUSIC_OUTRO_RISE_SEC: 3,     // بعد از رفتنِ گفتار، در چند ثانیه اوج بگیرد
  MUSIC_OUTRO_BED: 0.35,       // بلندیِ بستر زیرِ گفتار (نسبت به بلندیِ کامل)
  MUSIC_DUCK_FLOOR: 0.55,      // بلندیِ گوینده در لحظهٔ ورود (نه صفر)
  MUSIC_DUCK_RISE: 0.35,       // در چند درصدِ گذر به بلندیِ کامل می‌رسد
  MUSIC_DUCK_UNDER: 0.5,       // موسیقی زیرِ صدای گوینده تا این ضریب
  MUSIC_XFADE_HOLD: 0.5,       // گفتار→موسیقی: واژه‌های پایانی بریده نشوند
  MUSIC_LIMIT_KNEE: 28000,     // از این بالاتر نرم فشرده می‌شود، نه بریده
  // کفِ طولِ قطعه برای هر جایگاه. قطعه‌ای که از تلفیقِ لبه هم کوتاه‌تر
  // است، موسیقیِ آغاز نیست — و بی این کف، یک فایلِ سه‌ثانیه‌ای می‌توانست
  // موسیقیِ آغازِ قسمت شود چون بارِ استفاده‌اش صفر بود.
  MUSIC_MIN_EDGE_SEC: 8,       // شروع و پایان
  MUSIC_MIN_BRIDGE_SEC: 4,     // میانه
  MUSIC_SFX_XFADE_SEC: 0.35,   // افکت کوتاه است؛ لبه‌اش فقط نرم می‌شود
  MUSIC_GAIN: 0.8,             // ضریبِ بلندیِ کلی، روی بلندیِ خودِ ردیف
  MUSIC_MAX_CLIP_SEC: 45,      // سقفِ هر برش — نگهبانِ حافظه و زمان

  // ── افکتِ صوتی: عمداً سخت‌گیر ──
  // اگر معیار «آمدنِ یک واژه» باشد، هر اشارهٔ گذرا به باران یک صدای باران
  // می‌سازد؛ مصنوعی می‌شود و در درس‌نامه فاجعه است. پس واژه باید ساختاری
  // باشد (در سرِ بخش، یا دستِ‌کم دو بار در همان بخش) و سقفِ هر قسمت هم سخت.
  MUSIC_SFX_ENABLED: true,
  MUSIC_SFX_IN_SPECIAL: false, // درس‌نامه شمرده و بی‌جلوه است
  MUSIC_SFX_MAX_PER_EP: 1,     // حتی اگر ده جای مناسب باشد، یکی
  // و سه سدِ دیگر که تا ۵٫۶۴ نبودند:
  //  • افکتی که تأییدِ شنیداری ندارد پخش نمی‌شود (ستونِ «تأییدِ شنیداری»).
  //  • افکتی که با وایبِ بخش نمی‌خوانَد رد می‌شود — «واژه دو بار آمده» سنجهٔ
  //    بسامد است نه سنجهٔ تناسب؛ در یک بندِ سوگ، واژهٔ «در» هم دو بار می‌آید.
  //  • جای پخش از لنگرِ متنی می‌آید نه سرِ بخش، پس تکه‌ای که دو نیم می‌شود
  //    نباید نیمهٔ خیلی کوتاه بسازد.
  MUSIC_SFX_NEED_HEARD: true,
  /* سدِ بالا از ۵٫۶۵ تا ۵٫۸۰ هرگز باز نشد: مدل برای هیچ فایلی «جلوه»
     نداد و «نامعلوم» یعنی ردِّ دائمی. سدی که هیچ‌وقت باز نمی‌شود، سد
     نیست — نبودِ قابلیت است. پس شهادتِ دوم: فایلی که شناسنامهٔ منبع
     دارد (هویتش از صفحهٔ اثر آمده نه از حدسِ نام)، خودش را «افکت»
     اعلام کرده، و کوتاه است. وتوی «گفتار» سرِ جایش می‌ماند. */
  MUSIC_SFX_TRUST_SOURCE: true,
  MUSIC_SFX_MAX_SEC: 10,
  MUSIC_SFX_MIN_SPLIT: 40,     // نویسه — کوتاه‌تر از این، نصف نمی‌کنیم

  ONE_FILE_STRICT: true,

  // «درس‌نامه» هدفش ۱۵ دقیقه است ≈ ۴۳ مگابایت — بالاتر از سقفِ ادغام، پس
  // ناگزیر دو فایل می‌شود. یک‌فایلی‌کردنش یعنی کوتاه‌کردنِ درس به ~۱۱٫۵ دقیقه،
  // و این تصمیمِ محتوایی است نه فنی؛ پس خاموش می‌ماند تا صاحبِ برنامه بخواهد.
  // روشن که شود، سقفِ نویسهٔ درس‌نامه هم خودبه‌خود پایین می‌آید.
  // صاحبِ برنامه صریح گفت درس‌نامه هم باید یک فایل باشد. با روشن‌بودنش سقفِ
  // نویسهٔ درس‌نامه خودبه‌خود به اندازهٔ یک فایل می‌آید (specialMaxChars_)، پس
  // درس کوتاه‌تر می‌شود و در یک فایل جا می‌گیرد.
  /* ══ «یک فایل» دیگر خواستهٔ اول نیست (۶٫۴۳) ══
   * خواستهٔ صریحِ صاحبِ برنامه: «دغدغه‌ام در خصوصِ یک صوت شدنِ هر پادکست را
   * الان می‌توانم تجدیدنظر کنم، چون تو ناچار شدی سقفِ محتوا را کوتاه کنی…
   * سقفِ هر صوتِ درس‌نامه را بگذار حداقل روی ۱۵ دقیقه و اگر در دو فایل شد
   * مشکلی ندارد، چون در یوتیوب پادکست را در یک قسمت می‌بینم.»
   *
   * و علتش درست است: از ۶٫۴۳ هر درس می‌تواند به مجموعه‌های دیگر ارجاع بدهد.
   * متنِ درس + ارجاع‌ها + عصری‌سازی + غنی‌سازی در سقفِ ۱۰٫۸ دقیقه یعنی هر
   * چهارتا نصفه — و نصفه‌بودنِ چهار چیز بدتر از دو فایل شدنِ یک قسمت است.
   *
   * خاموش‌کردنش خودبه‌خود قیدها را برمی‌دارد: `specialMaxChars_` به هدفِ
   * ۱۵ دقیقه برمی‌گردد، و بندِ «یک فایل» در `applyEnrichment_` و
   * `explainBudget_` هر دو پشتِ همین کلیدند. */
  SPECIAL_ONE_FILE: false,


  // ---- فایل‌های تکه‌تکه‌شده ----
  // در شیت‌های تازه، فایل بزرگ تکه‌تکه تحلیل شده و هر قطعه یک ردیف است. قطعه‌ها
  // در یک تبِ موقت انبار می‌شوند و وقتی همهٔ قطعه‌های یک فایل رسید (یا ردیف
  // جمع‌بندی‌اش آمد) به یک آیتمِ واحد تبدیل می‌شوند. این‌طور یک کتابِ ۵۳ قطعه‌ای
  // یک آیتم می‌شود، نه ۵۳ تا — و ترتیب قطعه‌ها هم حفظ می‌شود.
  CHUNK_WAIT_HOURS: 18,        // اگر جمع‌بندی نرسید، بعد از این مدت با همان قطعه‌ها بساز

  // بیشترین قطعه‌ای که از یک فایل انبار می‌شود. بزرگ‌ترین فایلِ فعلی پنجاه‌وسه
  // قطعه دارد، پس این سقف امروز هیچ چیزی را کم نمی‌کند؛ ولی اگر روزی فایلی
  // پانصد قطعه‌ای بیاید، به‌جای پانصد ردیف، شصت قطعهٔ نمونه از سراسرِ فایل
  // (با گام یکنواخت، به‌علاوهٔ قطعهٔ آخر) انبار می‌شود — پوششِ کل فایل حفظ
  // می‌شود و تبِ انبار از کنترل خارج نمی‌شود.
  CHUNK_MAX_PER_FILE: 60,

  // ---- پادکست تخصصیِ مجموعه‌های آموزشی ----
  // فقط شیت‌هایی که فایل‌های بلندِ آموزشی دارند برای «مجموعه» اسکن می‌شوند.
  // دو شیت اولِ کلیپ‌کوتاه و عکس این‌جا جایی ندارند.
  /* ══ فهرستی که دو شیتِ کاملِ منبع را نامرئی کرده بود (۶٫۴۷) ══
   * گزارشِ صاحبِ برنامه: «همهٔ شیت‌های منبع رو نمی‌بینه… همهٔ تب‌هاشون رو
   * نمی‌بینه… قبلاً همه‌شون رو معرفی کردم.» و درست بود:
   * `SOURCES` پنج شیت داشت و این فهرست سه‌تا. `scanSeries` با
   * `indexOf(src.key) === -1` بقیه را رد می‌کرد — یعنی «RESULT (ویدیو)» با
   * ده هزار ردیف و «RESULT-PHOTO» با سی‌وشش هزار ردیف **هرگز** برای مجموعه‌ها
   * خوانده نمی‌شدند. هر چند بار هم اسکن زده می‌شد فرقی نمی‌کرد، و هیچ‌جا هم
   * گفته نمی‌شد که دو شیت اصلاً نگاه نشده‌اند.
   *
   * صافیِ درست جای دیگری است و از قبل هم بود: داوریِ محتوایی (`isCourse`)
   * که با خواندنِ متنِ واقعی تصمیم می‌گیرد چه چیزی درس است. صافیِ دومی در
   * سطحِ *شیت*، فقط چیزی را حذف می‌کرد که داور هرگز نمی‌دیدش.
   *
   * خالی یعنی «همه». فهرستِ صریح هنوز ممکن است، ولی دیگر پیش‌فرض نیست. */
  SERIES_SOURCES: [],
  SPECIAL_ENABLED: true,
  SPECIAL_HOUR: 8,                  // ساعت تولید روزانه به وقت دبی
  /* طولِ هدفِ قسمتِ **تمام‌شده**. رزروِ غنی‌سازی و عصری‌سازی از همین کم
     می‌شود، پس متنِ نوشته‌شده حدودِ ۱۵ دقیقه در می‌آید. از ۶٫۵۳ که دو فایل
     پذیرفته است («مشکلی با دو تا صوت ندارم؛ حقِ مطلب باید ادا بشه»)، این
     عدد از ۱۵ به ۲۰ رفت تا خودِ درس کوتاه نشود. */
  SPECIAL_TARGET_MINUTES: 20,
  // بودجهٔ متنِ خامِ درس در هر قسمت. پانزده دقیقه گفتار ≈ ۲۲۰۰ واژه ≈ ۱۳٬۰۰۰ نویسه
  // خروجی؛ برای نوشتنِ وفادار و بدون فشرده‌سازیِ بی‌جا، حدود سه برابرش متنِ ورودی
  // لازم است. این عدد سقفِ متنِ قطعه‌هایی است که در یک قسمت پوشش داده می‌شوند.
  SPECIAL_SOURCE_CHARS: 42000,
  SPECIAL_MIN_CHUNKS: 3,            // کف: قسمت با کمتر از این تعداد قطعه ساخته نمی‌شود
  // سقفِ متنِ یک قطعه در یک قسمت. قطعهٔ بلندتر بریده نمی‌شود؛ به چند «برش»
  // تقسیم می‌شود و برش‌های بعدی به قسمت‌های بعدیِ پادکست می‌روند. بی این،
  // یک قطعهٔ نودهزار نویسه‌ای به دوازده‌هزار بریده می‌شد و بقیه‌اش برای همیشه
  // پشتِ مکان‌نما جا می‌ماند — دقیقاً همان «هرز رفتنِ محتوا» که نباید بشود.
  SPECIAL_CHUNK_CHARS: 14000,
  SPECIAL_BUDGET_SLACK: 1.15,       // سقفِ سختِ متنِ ورودیِ یک قسمت (نسبت به بودجه)
  /* کف، در برابرِ سقف (۶٫۷۵). قسمتِ ۲۵ با ۴۶٪ هدف (۷:۴۸ در برابرِ ۱۶ دقیقه)
     بی‌صدا گذشت، چون نسبتِ هشدار ۰٫۴ بود و پرامپت هم «کوتاه‌تر ایرادی ندارد»
     می‌گفت. FLOOR_RATIO کفی است که specialExpand_ رویش کار می‌کند؛
     MIN_OUTPUT_RATIO آستانهٔ یافتهٔ sp-thin-episode است و کمی زیرِ آن،
     تا یافته فقط وقتی بزند که تلاشِ عمیق‌ترنویسی هم نتیجه نداده باشد. */
  SPECIAL_FLOOR_RATIO: 0.75,        // کمتر از این نسبتِ سقف → یک بار عمیق‌ترنویسی
  SPECIAL_MIN_OUTPUT_RATIO: 0.7,    // اگر متنِ خروجی کمتر از این نسبتِ هدف بود، ناقص است
  SPECIAL_STUCK_LIMIT: 2,           // بعد از این تعداد قسمتِ بی‌پیشرفت، به‌زور جلو می‌رویم
  SPECIAL_MAX_CHUNKS: 40,           // سقف قطعه در یک قسمت، حتی اگر متنشان کوتاه باشد
  SPECIAL_SECTIONS: 6,              // تعداد بخش‌های هدف در متن قسمت تخصصی
  SPECIAL_ENRICH: 8,                // چند آیتمِ مکمل از سایر شیت‌ها برای تعمیق
  SPECIAL_ENRICH_MIN_SCORE: 3,      // کف امتیاز شباهت برای پذیرفتن یک آیتم مکمل
  SPECIAL_RECAP_EPISODES: 4,        // مرور چند قسمت قبل در آغاز هر قسمت
  SERIES_MIN_CHUNKS: 4,             // فایلی با کمتر از این قطعه، «مجموعهٔ آموزشی» نیست
  // فایلِ «تنها» (بی قسمتِ دوم) باید واقعاً بلند باشد تا دوره حساب شود؛ وگرنه
  // هر کلیپِ چندقطعه‌ای یک «مجموعه» می‌شد و فهرست از دستِ آدم خارج می‌شد.
  SERIES_MIN_SOLO_CHUNKS: 8,
  // چند گروهِ ردشده در تخته نشان داده شود. سقف دارد چون آرشیوِ واقعی هزاران
  // کلیپِ کوتاه دارد و اندازهٔ Property محدود است.
  SERIES_REJ_KEEP: 250,

  // ---- داوریِ محتوایی مجموعه‌ها (نسخهٔ ۵٫۲) ----
  // تشخیصِ «آموزشی بودن» و دسته و سطح، از خواندنِ متنِ واقعیِ قطعه‌ها می‌آید.
  // نام فایل فقط یک نشانهٔ فرعی است: آرشیو پر است از فایل‌هایی که اسمشان چیزی
  // می‌گوید و محتوایشان چیز دیگری است.
  JUDGE_BATCH: 3,                   // چند مجموعه در یک فراخوانِ مدل داوری شود
  JUDGE_BATCHES_PER_RUN: 40,        // سقفِ فراخوان در هر اجرا؛ در عمل «مهلت» تعیین‌کننده است
  JUDGE_SAMPLES: 3,                 // چند قطعه از هر مجموعه نمونه‌برداری شود
  JUDGE_SAMPLE_CHARS: 2600,         // سقفِ نویسهٔ هر نمونه
  // سقفِ توکنِ خروجیِ داوری. با ۸۱۹۲، «فکرکردنِ» مدل کلِ سهم را می‌خورد و پاسخ
  // بی‌متن برمی‌گشت؛ همان چیزی که داوری را سه بار پشت سر هم صفر کرد.
  JUDGE_MAX_TOKENS: 24576,

  // ---- داوریِ بی‌مدل: پشتیبانی که هرگز صفر نمی‌ماند (نسخهٔ ۵٫۴) ----
  // اگر مدل جواب ندهد — پاسخِ بی‌متن، صافیِ محتوا، سقفِ سهمیه — داوری روی همان
  // متنی که قبلاً خوانده شده با قاعده‌های صریح انجام می‌شود. کیفیتش کمتر از
  // مدل است، ولی فهرست بی‌نظم و بی‌دسته نمی‌ماند و هیچ‌وقت «۰ از ۲۶۳» نمی‌شود.
  JUDGE_LOCAL_FALLBACK: true,
  JUDGE_LOCAL_DAYS: 3,              // داوریِ بی‌مدل زود دوباره با مدل امتحان می‌شود
  JUDGE_NOAI_MIN: 30,               // بعد از شکستِ مدل، این‌قدر دقیقه سراغش نمی‌رویم
  JUDGE_LOCAL_MAX: 500,             // سقفِ داوریِ بی‌مدل در یک اجرا
  JUDGE_LOCAL_SAMPLE_CHARS: 1600,   // نمونهٔ کوچک‌ترِ حالتِ بی‌مدل (سریع‌تر)
  // «متوسط»: هر چیزی که آموختنِ منظم دارد آموزشی است — سخنرانیِ تخصصی و
  // مصاحبهٔ عمیق هم بله؛ روضه و سینه‌زنی و مناسبت و کلیپ خبری نه.
  JUDGE_STRICTNESS: 'medium',
  JUDGE_MIN_SCORE: 45,              // کف امتیازِ آموزشی برای ورود به «درس‌نامه»
  JUDGE_REJUDGE_DAYS: 45,           // داوریِ کهنه‌تر از این، دوباره انجام می‌شود
  JUDGE_UNSURE_DAYS: 2,             // داوریِ «مشکوک» زودتر دوباره امتحان می‌شود
  JUDGE_MIN_SAMPLE_CHARS: 900,      // کمتر از این نویسه، نمونه کافی نیست
  SERIES_RESCAN_HOURS: 12,          // هر چند ساعت رجیستری مجموعه‌ها دوباره ساخته شود
  // اگر تولید چیزی برای ساختن پیدا نکرد، رجیستری همان لحظه به‌زور تازه می‌شود —
  // تا دوره‌ای که همین امروز اضافه شده، پشتِ سقفِ دوازده‌ساعته جا نماند.
  SERIES_FORCE_ON_IDLE: true,

  ALERT_NO_EPISODE_HOURS: 30,  // اگر بیش از این مدت قسمتی ساخته نشد، هشدار بده
  ALERT_NO_SPECIAL_HOURS: 30,  // همان، برای پادکست تخصصی
  ALERT_SYNC_BEHIND: 2000,     // اگر همگام‌سازی این‌قدر ردیف عقب افتاد، هشدار بده

  // ---- دیدبانی خودِ شیت‌های منبع ----
  // آستانهٔ «راکد» و «کم‌کار» ثابت نیست: از فاصلهٔ معمولِ خودِ همان تب حساب
  // می‌شود (شش برابر و سه برابر). این دو عدد فقط کفِ آن آستانه‌اند تا تبی که
  // ساعتی ردیف می‌گیرد، با چند ساعت وقفه «راکد» اعلام نشود.
  // آستانه = «سکوتِ معمولِ خودِ آن تب» × ضریب. برای تبی که ساعتی ردیف می‌گیرد
  // این چند روز می‌شود و برای تبی که هفته‌ای یک‌بار دسته‌ای کار می‌کند، چند هفته.
  PULSE_STALL_FACTOR: 2.5,     // ضریبِ «راکد»
  PULSE_SLOW_FACTOR: 1.4,      // ضریبِ «کم‌کار»
  PULSE_MIN_STALL_DAYS: 2,     // کفِ آستانهٔ «راکد» (برای تب‌های پرترافیک)
  PULSE_MIN_SLOW_DAYS: 1,      // کفِ آستانهٔ «کم‌کار»
  PULSE_MAX_STALL_DAYS: 60,    // سقف، تا یک وقفهٔ تاریخیِ بلند آستانه را بی‌نهایت نکند
  PULSE_UNKNOWN_STALL_DAYS: 14, // وقتی هنوز الگوی تب شناخته نیست (همه‌چیز در یکی دو روز آمده)
  // افتِ ظرفیت: اگر میانهٔ ردیف‌در‌روزِ هفتهٔ اخیر کمتر از این نسبت از دورهٔ
  // پیش از آن شود، «کم‌کار» اعلام می‌شود — حتی اگر هنوز قطره‌قطره ردیف بیاید.
  PULSE_SLOW_RATIO: 0.25,

  // ---- نام تب‌ها ----
  TAB_INDEX: '_داشبورد',
  TAB_PODCASTS: 'پادکست‌ها',
  TAB_LOG: '_گزارش',
  TAB_PRON: 'تلفظ',
  TAB_AUDIT: 'سنجهٔ محتوا',     // نتیجهٔ مقایسهٔ متنِ نهایی با متن‌های خام
  CAL_TAB: 'تقویمِ تولید',      // روزهای تولیدِ هر برنامه و استثناها
  // ══ بخشِ ۳۲ — «صداها» ══
  // شخصیتِ خواندن (مکث و کشش و دامنه)، نه رنگِ صدا. جدولش در هاب است و
  // هر ردیفِ تازه **خاموش** ساخته می‌شود: روشن بودنش یعنی خوانشِ هر
  // قسمت همان شبِ نصب عوض شود، بی آنکه کسی خواسته باشد.
  PERSONA_TAB: 'صداها',
  // چند قسمتِ تولیدشده در فهرستِ تیک‌زدنِ هر برنامه نشان داده شود (۷٫۵۹).
  PERSONA_EP_LIST: 40,
  PERSONA_ENABLED: true,
  CHUNK_TAB: '_قطعات',         // انبار موقت قطعه‌های فایل‌های بزرگ
  SRC_ERR_TAB: '_خطاهای منبع', // ردیف‌هایی که خط لولهٔ شما در آن‌ها خطا نوشته
