  YT_QUEUE_ID: '1qerT_vwZpOTFhMXYv-J0m2cIC8Eiv8L-',  // شناسهٔ ثابتِ _YT-RENDER.json
  YT_RENDER_MAP: 'docs/renders.json',   // نقشهٔ ویدئوهای ساخته‌شده، در ریپو
  YT_SHARE_DAYS: 3,                     // بیش از این، اشتراکِ صوت پس گرفته می‌شود
  YT_COLLECT_MAX: 3,                    // چند ویدئو در هر اجرا برداشته شود
  YT_COLLECT_MS: 120000,

  /* ── بازخوردِ یوتیوب (۶٫۷) ──
