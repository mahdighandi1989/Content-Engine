function props_() { return PropertiesService.getScriptProperties(); }

function apiKey_() {
  var k = props_().getProperty(PK.API_KEY);
  if (!k) throw new Error(
    'کلید Gemini تنظیم نشده است. از منوی «موتور محتوا» گزینه «۱) ثبت کلید Gemini» را اجرا کنید.');
  return k;
}

function nowStr_() {
  return Utilities.formatDate(new Date(), CFG.TIMEZONE, 'yyyy-MM-dd HH:mm');
}

function logLine_(msg) {
  try {
    var sh = getHub_().getSheetByName(CFG.TAB_LOG);
    if (sh) sh.appendRow([nowStr_(), String(msg).slice(0, 900)]);
  } catch (e) { /* گزارش هرگز نباید اجرا را متوقف کند */ }
  console.log(msg);
}
