  // اعراب‌دار شد، دقیقاً همان دستوری که جلوی این اشتباه را می‌گرفت خاموش ماند —
  // و گزارشِ کاربر همین بود: «بابا» را baawbaaw می‌خواند.
  TTS_STYLE_BASE: 'گویندهٔ حرفه‌ایِ رادیوی ایران، فارسیِ معیارِ تهرانی. ' +
                  'الف را باز و کوتاه بگو، نه کشیده و گِرد — نه لهجهٔ افغانی',

  // یادآورِ تلفظ برای متنی که (به هر دلیل) بی‌اعراب مانده — باز هم کوتاه.
  // این یکی همچنان شرطی است و درست هم هست: فقط دربارهٔ صدای کوتاه حرف می‌زند،
  // و متنِ اعراب‌دار واقعاً خودش آن را می‌گوید.
  TTS_PRON_HINT: 'زیر و زبر و پیشِ حروف را کامل ادا کن',

  // و یادآورِ «روان‌خوانی» برای متنی که *اعراب دارد*.
  //
  // چرا شرطش وارونهٔ بالایی است: گزارشِ کاربر این بود که «گویا جدا جدا روی
  // کلمات فقط تمرکز می‌کند». دقیقاً همان‌جا پیش می‌آید که متن پُر از نشانه
  // است — مدل هر واژه را با دقتِ املایی ادا می‌کند و پیوندِ عبارت را از دست
  // می‌دهد. پس یادآورِ پیوستگی جای همان‌جاست، نه جای متنِ خالی.
  TTS_FLOW_HINT: 'عبارت‌به‌عبارت و پیوسته بخوان نه واژه‌به‌واژه؛ مکث فقط جای نشانه‌ها',

  // سقفِ طولِ کلِ سطرِ دستور. اگر لحنِ بخش بلندتر باشد، بریده می‌شود —
  // دستورِ بلند دشمنِ اجراست، نه کمکش.
  // سقف کمی بالا رفت چون لهجه به سطرِ پایه اضافه شد، ولی عمداً کم — نگهبانِ
  // «دستور باید کوتاه بماند» همان چیزی است که جلوی خوانده‌شدنش را می‌گیرد.
  // بریدن از ته انجام می‌شود، پس اگر لحنِ بخش بلند باشد همان بریده می‌شود نه
  // لهجه؛ و این ترتیبِ درستی است: لهجهٔ غلط از لحنِ ناکامل بدتر است.
  TTS_CUE_MAX: 320,

  // هر بار که سطرِ دستور همراهِ متن فرستاده شود، یک شانسِ تازه است که مدل
  // به‌جای اجرا، خودش را بخواند. این بارها گزارش شد: «گوینده وسطِ متن، دستورِ
  // لحن را هم می‌خواند». کوتاه‌کردنِ دستور کمش کرد ولی تمامش نکرد — چون تعدادِ
  // دفعات دست‌نخورده ماند: یک قسمتِ ۱۴ دقیقه‌ای بیش از ده تکه دارد و هر تکه
  // دستورِ خودش را می‌گرفت.
  //
  //   'perSection' (پیش‌فرض) — دستور فقط در نخستین تکهٔ هر لحن. تا وقتی لحن
  //        عوض نشده، تکه‌های بعدی متنِ خالی می‌گیرند. صدا از voiceConfig می‌آید،
  //        نه از دستور، پس گوینده عوض نمی‌شود.
  //   'perChunk'   — رفتارِ قدیمی؛ برای مقایسه نگه داشته شده.
  // 'perSection' = سرِ هر بخش · 'always' = هر تکه · 'off' = هرگز.
  // «off» تنها حالتی است که *ساختاراً* ممکن نیست دستور خوانده شود، چون
  // اصلاً دستوری فرستاده نمی‌شود. بهایش لحنِ خنثی‌تر است.
  TTS_CUE_MODE: 'perSection',
  // پس از ساختِ هر تکه‌ای که دستور گرفته، شش ثانیهٔ اولش به مدل داده
  // می‌شود تا بگوید چه شنیده. اگر دستور خوانده شده باشد، همان تکه بی
  // دستور دوباره ساخته می‌شود. این تنها سنجه‌ای است که واقعاً می‌شنود؛
  // مقایسهٔ طول برای تکه‌های بلند قاطع نیست.
  TTS_CUE_VERIFY: true,
  TTS_CUE_VERIFY_SEC: 6,


  // سازگاری با کدها و آزمون‌های قدیمی؛ در ساختِ صدا دیگر استفاده نمی‌شود.
  TTS_STYLE_TAIL: '',

  // متنِ صوتیِ اعراب‌دار (فتحه/کسره/ضمه/سکون، تلفظِ تهرانی) پیش از صداگذاری
  // ساخته می‌شود؛ اول از پاسخِ Cowork، وگرنه با مدل — و همیشه با وارسیِ
  // «واژه‌به‌واژه همان متن است». false یعنی مثل قبل با متنِ ساده بخوان.
  TASHKIL_ENABLED: true,

  // ── بازبینیِ اجباریِ متنِ صوتی (۶٫۲۰) ──
  // «بعد از یک بار نوشته حتماً دقایقی بعدش مجدد بررسی بشه» — درخواستِ صریحِ
  // کاربر، و درست هم هست: هر سدی که تا امروز روی متنِ اعراب‌دار بود *ساختاری*
  // بود، نه معنایی. verifySpeak_ ثابت می‌کند همان واژه‌هاست و speakVowelledOk_
  // ثابت می‌کند نشانه کم نیست؛ هیچ‌کدام نمی‌گویند نشانه‌ها *درست*اند.
  // «بایستیم» با فتحه روی ب از هر دو سد رد می‌شود و در گوش «با» شنیده می‌شود.
  SPEAK_REVIEW: true,
  SPEAK_REVIEW_MIN: 3,         // چند دقیقه بعد از نوشتن، بازبینی شروع شود
  SPEAK_REVIEW_MAX: 14,        // سقفِ بخش‌هایی که در یک اجرا بازبینی می‌شوند

  // نشانه‌گذاریِ آوایی: مدل اجازه دارد «،» و «…» و «—» و «:» و نیم‌فاصله
  // اضافه/کم کند تا عبارت‌بندی درست شود. تا ۶٫۱۹ اجازه نداشت — نه به‌خاطرِ
  // قاعده‌ای، بلکه چون speakCmp_ نشانه‌ها را در مقایسه نگه می‌داشت و هر ویرگولِ
  // افزوده وارسی را می‌شکست؛ یعنی بخش با متنِ *بی‌اعراب* خوانده می‌شد.
  // ══ روشن، خاموش، و حالا روشنِ ایمن (۶٫۲۹) ══
  // ۶٫۲۶ این را خاموش کرد تا مدل نتواند نیم‌فاصلهٔ نابه‌جا بگذارد — ولی
  // پرامپت هنوز از مدل ویرگول و نیم‌فاصله می‌خواست و speakCmp_ هر دو را
  // ردّ می‌کرد. نتیجه در قسمتِ واقعی: از ۱۳ بخشِ «مرورِ بزرگ»، ۸ بخش
  // (۶۲٪) **بی هیچ اعرابی** خوانده شد و `__speakFails` روی ۱۸ ایستاد.
  // یعنی سدی که برای بهترکردنِ تلفظ گذاشته شده بود، تلفظ را از همیشه بدتر کرد.
  // حالا نیم‌فاصله *تعمیر* می‌شود نه ردّ (speakZwnjFix_)، پس نشانه‌گذاریِ
  // آوایی — که خواستهٔ صریحِ صاحبِ برنامه بود — دوباره باز است.
  SPEAK_MARKS: true,

  // واژه‌هایی که بازبین «با اعراب هم درست خوانده نمی‌شوند» تشخیص می‌دهد، به تبِ
  // «تلفظ» افزوده می‌شوند تا برای همیشه اصلاح بمانند. فقط افزودن، هرگز
  // بازنویسیِ سطرِ آدمی؛ و فقط وقتی حروفِ جایگزین با حروفِ اصلی یکی باشد.
  SPEAK_LEARN: true,
  SPEAK_LEARN_MAX: 6,          // سقفِ سطرِ خودکار در هر قسمت

  // ── عصری‌سازیِ درس‌نامه (۶٫۲۱، بخشِ ۲۹) ──
  // «یه نفر غیر از اون گوینده در لا‌به‌لای هر مطلب بیاد توضیح بده … با
  // مثال‌های امروزی و ملموس». فقط درس‌نامه؛ «از همه جا از همه رنگ» این را
  // لازم ندارد و صریحاً خواسته نشده.
  EXPLAIN_ENABLED: true,
  // ۱۳ عددِ خودِ صاحبِ برنامه است: «شاید لازم باشه سهمیهٔ ۱۳ درصد … افزایش
  // پیدا کنه». روی *متنِ درس* حساب می‌شود نه روی سقفِ فایل — درسِ کوتاه
  // توضیحِ کوتاه می‌خواهد.
  /* ۱۳ ← ۲۰ (۶٫۴۳): «اون توضیحاتِ خودمونی و ساده و عصری‌سازی بینِ هر درس
     هم از این حالتِ خیلی مسخره و کوتاه و بی‌معنی در بیاد، خیلی بهتر بشه و
     ملموس‌تر.» با سقفِ ۱۰٫۸ دقیقه، ۱۳٪ یعنی چند جمله؛ حالا که سقف ۱۵ دقیقه
     است، جا هست. */
  EXPLAIN_PCT: 20,
  // سه جا در یک قسمت. توضیح‌دهنده‌ای که همه‌جا باشد دیگر توضیح‌دهنده نیست،
  // گویندهٔ دوم است و درس را دو برابر می‌کند.
  EXPLAIN_MAX_SPOTS: 3,
  /* کفِ طولِ یک تیکه. توضیحی که یکی دو مثالِ ملموس دارد زیر این نمی‌شود؛
     ۸۰ نویسهٔ اول یعنی یک جملهٔ تعارفی هم قبول می‌شد و همان شنیده شد.
     و اگر سهم حتی برای *یکی* کافی نباشد، هیچ — یک تیکهٔ خوب بهتر از سه
     تیکهٔ بریده است، و تیکهٔ بریده از نبودنش بدتر.

     ۲۶۰ ← ۵۰۰ (۶٫۴۳): «از این حالتِ خیلی مسخره و کوتاه در بیاد.» ۲۶۰ نویسه
     دو جمله است — همان چیزی که او شنید و مسخره خواندش. با بودجهٔ ۲۰٪ از یک
     درسِ پانزده‌دقیقه‌ای (حدودِ ۱۵۰۰ نویسه)، کفِ ۵۰۰ یعنی **سه جایگاهِ
     پُر** به‌جای پنج تیکهٔ نازک. عدد از حساب آمده، نه از حدس: با ۷۰۰ فقط
     دو جا می‌ماند و «لا‌به‌لای هر درس» بی‌معنا می‌شد. */
  EXPLAIN_MIN_CHARS: 500,
  // بازبینیِ محتوایی: «واقعاً توضیح می‌دهد؟ مثالِ ملموس دارد؟ به همین بخش
  // ربط دارد؟» — خواستهٔ صریحِ کاربر بود و در ۶٫۲۱ جا افتاد.
  EXPLAIN_REVIEW: true,

  // ── قسمتِ مرورِ بزرگ (۶٫۲۲، بخشِ ۳۰) ──
  // «یه پادکست به صورت استثنا … همهٔ مفاهیم قسمت‌های گذشته رو اون یه نفر با
  // همون لحن و سادگی و مثال‌های بسیار ملموس بیاد توضیح بده.»
  RECAP_ENABLED: true,
  // هشت درس کفِ معناداری است: با سه چهار درس هنوز چیزی برای «مرورِ بزرگ»
  // نیست، و مرورِ زودهنگام همان قسمتی است که کسی دوباره گوش نمی‌دهد.
  RECAP_MIN_PARTS: 8,
  // سفارشی که نشود، صف را برای بقیه نمی‌بندد.
  RECAP_TRY_MAX: 3,

  /* سقفِ تیک‌های درس در جعبهٔ دامنهٔ مرور (۶٫۴۰). تخته ۲۶۴ ردیف دارد و
     این فهرست برای هر مجموعه‌ای که درسی ساخته رندر می‌شود؛ بریده‌شدنش در
     خودِ جعبه نوشته می‌شود، چون درسی که دیده نشود انگار وجود ندارد. */
  RECAP_PICK_MAX: 60,

  TTS_CHUNK_CHARS: 1100,       // حداکثر طول هر تکه متن ارسالی به TTS
  // وقتی که باید برای «یک تکهٔ صوتیِ دیگر» کنار گذاشته شود.
  // چرا: حلقهٔ صداگذاری فقط *پیش از شروعِ* هر تکه ساعت را می‌دید. اگر ساعت
  // چند ثانیه به مهلت مانده بود، تکهٔ تازه شروع می‌شد و یک فراخوانِ گفتارسازی
  // می‌تواند بیش از یک دقیقه طول بکشد — یعنی ردشدن از سقفِ شش‌دقیقه‌ایِ گوگل و
  // پیامِ «Exceeded maximum execution time». حالا تکهٔ تازه فقط وقتی شروع
  // می‌شود که وقتِ تمام‌کردنش هم باشد.
  TTS_RESERVE_MS: 110000,
  // و ادغام هم یک عملیاتِ تک‌تکه و نابخش‌پذیر است: اگر وسطش مهلت تمام شود،
  // هیچ راهی برای ادامه نیست. با سقفِ پایین‌تر، قسمت‌های بلند تکه‌تکه می‌مانند
  // (که مشکلی نیست) به‌جای اینکه کلِ اجرا کشته شود.
  MERGE_RESERVE_MS: 150000,
  SAMPLE_RATE: 24000,          // خروجی Gemini TTS: PCM 24kHz، ۱۶ بیت، تک‌کاناله
  MAX_WAV_BYTES: 10000000,     // ~۳٫۵ دقیقه در هر فایل؛ قسمت بلندتر به چند بخش نوشته می‌شود

  // پس از آماده‌شدن بخش‌ها، یک فایل یکجا هم ساخته می‌شود تا تلگرام کل قسمت را
  // در یک فایل بفرستد. سقف آپلود ربات تلگرام پنجاه مگابایت است.
  MERGE_AUDIO: true,
  // سقفِ هر فایلِ یکجا. تلگرام تا پنجاه مگابایت را می‌پذیرد، ولی محدودیتِ
  // واقعیِ ما تلگرام نیست: خودِ Apps Script است. چسباندن در حافظه انجام
  // می‌شود و رشتهٔ base64 چهار سومِ حجمِ فایل است. تجربهٔ ۱۲ مرداد: ادغامِ
  // ۳۸ مگابایت (درس‌نامه) سالم تمام شد و ادغامِ ۴۱٫۷ مگابایت (برنامهٔ متنوع،
  // هفت بخش) اجرا را کشت — بی هیچ استثنای قابلِ گرفتن و بی هیچ سطری در سیاهه.
  // پس سقف را زیرِ آن مرز می‌گذاریم: ~۱۱ دقیقه در هر فایل. قسمتِ بلندتر دو
  // فایلِ متوازن می‌شود، که از یک ادغامِ کشته‌شده بی‌نهایت بهتر است.
  // ۱۲ مرداد ۳۸ مگابایت سالم ادغام شد و ۴۱٫۷ اجرا را کشت. ۳۶ زیرِ آن مرز است
  // و همچنان حاشیه دارد — و همین ~۱٫۵ دقیقه بیشتر، مرزِ «یک فایل» را از ۱۱٫۴ به
  // ۱۲٫۵ دقیقه می‌برد که تقریباً همهٔ قسمت‌های واقعی را پوشش می‌دهد.
  MERGE_MAX_BYTES: 36000000,

  // نرخِ گفتارِ فارسیِ این گوینده: نویسه بر ثانیه. از هدفِ ۱۰ دقیقه/۱۵۰۰ واژه
  // به دست آمده (۱۵۰ واژه در دقیقه × ~۵٫۵ نویسه = ~۱۳٫۷).
  //
  // ══ این عدد «فقط یک تخمین» نبود؛ تصمیمِ یک‌فایل/دوفایل بود (۶٫۲۹) ══
  // کامنتِ پیشین می‌گفت «فقط برای تخمینِ پیش از ساخت … نه برای چیزی که باید
  // دقیق باشد». نادرست بود: `oneFileMaxChars_` تنها از همین عدد می‌آید، و
  // آن سقفْ تعیین می‌کند قسمت در یک فایل برود یا دو تا.
  //
  // اندازه‌گیریِ واقعی (قسمت ۱۹ درس‌نامه، ۲۷ اوت): ۷٬۲۹۷ نویسهٔ گفتنی →
  // ۳۶٬۱۶۱٬۶۰۴ بایت صدا = ۷۵۳ ثانیه. یعنی ۹٫۷ نویسه بر ثانیه، نه ۱۳٫۷ —
  // و با حاشیهٔ ۸ درصدی هم فرض ۱۲٫۶ بود، یعنی ۳۰٪ خوش‌بینانه. برای همین
  // *هر* قسمت دو فایل می‌شد، هر چه سقف را در جای دیگری سفت‌تر می‌کردیم.
  // حالا این فقط دانهٔ اولیه است؛ عددِ واقعی از خروجیِ خودِ قسمت‌ها می‌آید.
  //
  // ولی دانه هم باید صادق باشد: تا دو قسمتِ اول اندازه‌گیری نشوند، همین عدد
  // سقف را می‌سازد و دو شبِ دیگر هم قسمت دو فایل می‌شود. ۱۰ کمی زیرِ
  // اندازه‌گیریِ واقعی است (۹٫۷ سرتاسری، ~۱۰٫۳ اگر موسیقی را جدا حساب کنیم)
  // و سقفِ تنگ‌تر بی‌ضرر است؛ سقفِ گشاد دو فایل می‌سازد.
  SPEECH_CHARS_PER_SEC: 10,

  // ── کالیبراسیونِ اندازه‌گیری‌شده (۶٫۲۹) ──
  // پس از هر قسمت، «بایتِ صدا به ازای هر نویسهٔ متنِ گفتنی» ثبت می‌شود و
  // سقفِ یک فایل از میانهٔ همین اندازه‌گیری‌ها می‌آید، نه از یک ثابتِ حدسی.
  // میانه (نه میانگین) چون یک قسمتِ ناقص نباید سقف را جابه‌جا کند.
  SPEECH_CALIB: true,
  SPEECH_CALIB_KEEP: 8,        // چند قسمتِ اخیر نگه داشته شود
  SPEECH_CALIB_MIN: 2,         // زیرِ این شمار، هنوز به فرمولِ قدیمی تکیه می‌کنیم
  // مرزهای عقل: خارج از این بازه یعنی اندازه‌گیری خراب است، نه گوینده کند.
  SPEECH_BPC_MIN: 2000,
  SPEECH_BPC_MAX: 9000,
  // حاشیهٔ سقفِ یک فایل. ۳٫۴ ثانیه بالاتر از سقف هم «دو فایل» است، پس
  // حاشیه باید واقعی باشد نه اسمی.
  ONE_FILE_MARGIN: 0.94,

  // «یک فایلِ واحد» خواستهٔ صریحِ صاحبِ برنامه است: دو تکه، کارِ حرفه‌ای به نظر
  // نمی‌رسد. مرزش را حدس نمی‌زنیم — از همان MERGE_MAX_BYTES و نرخِ گفتار حساب
