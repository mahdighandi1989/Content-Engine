  YT_TICK_HOURS: 2,
  YT_TICK_MS: 240000,
  YT_VIDEO_MARK: 'ویدئو',               // نامِ فایلِ MP4 در پوشهٔ قسمت
  /* ── رندرِ بیرونی (۶٫۶) ──
