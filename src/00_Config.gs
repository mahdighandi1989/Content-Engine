  YT_MAX_PER_RUN: 3,                    // آپلود در هر اجرای شبانه
  YT_MANUAL_MAX: 6,                     // آپلود در هر فشردنِ دکمه
  YT_MS: 150000,                        // بودجهٔ زمانیِ هر اجرا
  YT_BACKFILL_WALK: 12,                 // پوشهٔ قسمت در هر کاوشِ گذشته
  YT_RENDER_FILE: '_YT-RENDER.json',
