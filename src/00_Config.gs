  YT_TRY_MAX: 3,                        // پس از این، آن قسمت رها می‌شود
  YT_STUCK_DAYS: 3,
  /* سهمیهٔ یوتیوب دو سطل دارد و هر دو بی‌صدا بسته می‌شوند (۴۰۳)، پس خودمان
