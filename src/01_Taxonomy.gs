// نرمال‌سازی فارسی: عربی→فارسی، حذف اعراب، نیم‌فاصله→فاصله، حذف نشانه‌گذاری
function txNorm(s) {
  if (s === null || s === undefined) return '';
  s = String(s);
  s = s.replace(/\u064A/g, '\u06CC').replace(/\u0643/g, '\u06A9')
       .replace(/\u0629/g, '\u0647').replace(/\u0649/g, '\u06CC');
  s = s.replace(/[\u064B-\u0652\u0670]/g, '');
  s = s.replace(/[\u200C\u200E\u200F]/g, ' ');
  s = s.replace(/[\u061F\u060C\u061B!?.,:;()\[\]{}"'\u00AB\u00BB\/\\|\u2013\u2014_\-]+/g, ' ');
  s = s.replace(/\s+/g, ' ');
  return ' ' + s.trim().toLowerCase() + ' ';
}

