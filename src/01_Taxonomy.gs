var TX_W_LABEL = 6, TX_W_TOPIC = 3, TX_W_MSG = 2, TX_W_BODY = 1;
var TX_A_FIRST = 34, TX_A_OTHER = 20;

function txLabelTokens(label) {
  if (!label) return [];
  var raw = String(label).split(/[\u060C,\u061B\/\u00B7|]+/);
  var out = [];
  for (var i = 0; i < raw.length; i++) {
    var t = raw[i].replace(/\([^)]*\)/g, ' ');
    t = txNorm(t).trim();
    if (t) out.push(t);
  }
  return out;
}

/**
 * طبقه‌بندی یک آیتم.
 * @return {{key:string, title:string, secondKey:string, secondTitle:string, scores:Object}}
 */
function txClassify(label, topic, message, body) {
  var fields = [[txNorm(label), TX_W_LABEL], [txNorm(topic), TX_W_TOPIC],
                [txNorm(message), TX_W_MSG], [txNorm(body), TX_W_BODY]];
  var tokens = txLabelTokens(label);
  var scores = {}, any = false;

  for (var c = 0; c < TAXONOMY.length; c++) {
    var cat = TAXONOMY[c], s = 0, f, kw, k;
    for (f = 0; f < fields.length; f++) {
      var txt = fields[f][0], w = fields[f][1];
      if (!txt.trim()) continue;
      for (kw = 0; kw < cat.kws.length; kw++) {
        k = txNorm(cat.kws[kw]).trim();
        if (k && txt.indexOf(k) !== -1) s += w * (k.length > 6 ? 2 : 1);
      }
    }
    var anch = ANCHORS[cat.key] || [];
    for (var i = 0; i < tokens.length; i++) {
      var tok = tokens[i];
      for (var a = 0; a < anch.length; a++) {
        var an = txNorm(anch[a]).trim();
        if (!an) continue;
        if (tok === an || tok.indexOf(an + ' ') === 0) { s += (i === 0 ? TX_A_FIRST : TX_A_OTHER); break; }
        else if (tok.indexOf(an) !== -1) { s += (i === 0 ? TX_A_OTHER : 10); break; }
      }
    }
    if (s > 0) { scores[cat.key] = s; any = true; }
  }

  if (!any) return {key: MISC_KEY, title: MISC_TITLE, secondKey: '', secondTitle: '', scores: {}};

  var order = {};
  for (var q = 0; q < TAXONOMY.length; q++) order[TAXONOMY[q].key] = q;
  var ranked = Object.keys(scores).sort(function (x, y) {
    if (scores[y] !== scores[x]) return scores[y] - scores[x];
    return order[x] - order[y];
  });
  var titleOf = function (kk) {
    for (var z = 0; z < TAXONOMY.length; z++) if (TAXONOMY[z].key === kk) return TAXONOMY[z].title;
    return MISC_TITLE;
  };
  var second = '', secondTitle = '';
  // دسته فرعی فقط وقتی معنادار است که امتیازش دست‌کم ۵۰٪ دسته اصلی باشد
  if (ranked.length > 1 && scores[ranked[1]] >= scores[ranked[0]] * 0.5) {
    second = ranked[1]; secondTitle = titleOf(second);
  }
  return {key: ranked[0], title: titleOf(ranked[0]), secondKey: second,
          secondTitle: secondTitle, scores: scores};
}

/** امتیاز سودمندی تحریریه‌ای ۰ تا ۱۰۰ */
function txPriority(rec) {
  var p = 40;
  var summ = String(rec.summary || '').trim();
  var msg  = String(rec.keyMessage || '').trim();
  var body = String(rec.body || '').trim();
  p += Math.min(20, Math.floor(summ.length / 40));
  p += Math.min(12, Math.floor(msg.length / 30));
  p += Math.min(18, Math.floor(body.length / 50));
  if (rec.vibe) p += 4;
  if (rec.kind === 'video') p += 6;
  if (!rec.link || String(rec.link).indexOf('drive.google.com') === -1) p -= 25;
  var low = txNorm(rec.rawLabel || '');
  var junk = ['رابط کاربری', 'مدیریت فایل', 'پروفایل'];
  for (var j = 0; j < junk.length; j++) if (low.indexOf(txNorm(junk[j]).trim()) !== -1) p -= 30;
  if (body.length < 15 && summ.length < 60) p -= 15;
  return Math.max(0, Math.min(100, p));
}
