function runScanSeries() {
  var r;
  try { r = scanSeries(true); } catch (e) { r = { error: e.message }; }
  var hub = getHub_();
  var reg = readSeriesReg_(hub);
  var L = ['مجموعه‌های شناسایی‌شده: ' + reg.rows.length];
