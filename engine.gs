      (ids.length ? auditSourceText_(snap, ids) : '[هیچ منبعی به این بخش اِسناد داده نشده]') +
      '\n\nمتنِ نهایی که گوینده خوانده:\n' + auditCut_(secs[i].narration, 2500));
  }

  /* درس‌نامه «آموزش» است و برنامهٔ ترکیبی «گزارش». یک معیار برای هر دو،
     یکی از آن دو را هر شب بی‌دلیل رد می‌کند. */
  var isLesson = String(snap.show) === ENRICH_SHOW_SPECIAL;
