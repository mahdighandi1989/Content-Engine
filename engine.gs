        behavior: { type: 'string' },     // چه کاری را متفاوت انجام بدهم
        message: { type: 'string' }       // پیام اصلی در یک جمله
      },
      required: ['problem', 'behavior', 'message']
    },
    sections: {
      type: 'array',
      items: {
        type: 'object',
