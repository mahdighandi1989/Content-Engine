           v[SC.CHUNKS - 1] + ' قطعه — ' + v[SC.STATUS - 1] +
           (v[SC.ORDER - 1] ? ' (ترتیب ' + v[SC.ORDER - 1] + ')' : ''));
  }
  var m = L.join('\n');
  var ui = ui_(); if (ui) ui.alert('مجموعه‌های آموزشی', m, ui.ButtonSet.OK); else console.log(m);
  return r;
}

