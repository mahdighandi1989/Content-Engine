  // سیاست انتخاب مدل:
  //   'highest' = بالاترین مدل ممکن، حتی اگر پیش‌نمایش (preview) باشد — کیفیت بیشتر
  //   'stable'  = فقط نسخه‌های پایدار — پایداری بیشتر، کیفیت کمی کمتر
  // در هر دو حالت اگر مدلی بازنشسته شود، جانشینش خودکار انتخاب می‌شود.
  MODEL_POLICY: 'highest',

  // ---- هویتِ دو برنامه ----
  // برنامهٔ روزانهٔ متنوع: از تلفیقِ کلیپ و صدا و عکس و سند ساخته می‌شود.
  SHOW_NAME: 'از همه جا از همه رنگ',
  SHOW_TAGLINE: 'برنامهٔ روزانهٔ آرشیو',
  // برنامهٔ تخصصی: روی مجموعه‌های آموزشیِ بلند و قطعه‌قطعه‌شده تمرکز دارد.
  SPECIAL_SHOW_NAME: 'درس‌نامه',
  SPECIAL_TAGLINE: 'پادکست تخصصیِ مجموعه‌های آموزشی',

  // یک گویندهٔ ثابت برای هر برنامه (مثل یک مجریِ واحد در رادیو).
  // تنوع باید از «نحوهٔ خواندن» بیاید نه از عوض‌شدن آدم — ولی دو برنامهٔ
  // متفاوت دو مجریِ متفاوت دارند تا از روی صدا فوراً تشخیص داده شوند.
  // این دو فقط «صدای پشتیبان»اند: اگر نقش‌گزینی به هر دلیل انجام نشود یا API
  // نامی را نپذیرد، اجرا با این‌ها ادامه می‌دهد. انتخابِ واقعیِ گوینده در
  // 20_Voices.gs بر پایهٔ محتوا و با گردشِ روزانه انجام می‌شود.
  TTS_VOICE: 'Charon',         // پشتیبانِ «از همه جا از همه رنگ»
  TTS_VOICE_SPECIAL: 'Kore',   // پشتیبانِ «درس‌نامه»
  // نقش‌گزینیِ چندصدایی: هر قسمت یک گویندهٔ اصلی و یک-دو همراه دارد، و انتخاب
  // از رویِ سرشتِ متن است. هیچ برنامه‌ای جنسیتِ ثابت ندارد.
  TTS_CAST_ENABLED: true,
  // اگر صدایی به گوشتان جور درنیامد، نامش را این‌جا (یا در ویژگیِ VOICE_BLOCK)
  // با کاما بنویسید تا دیگر انتخاب نشود.
  TTS_VOICE_BLOCK: '',

  // پایهٔ لحن: هویت گوینده و قواعد تلفظ. در همهٔ بخش‌ها ثابت است.
  //
  // چرا این بخش این‌قدر سخت‌گیرانه و پرتکرار است: بازخوردِ واقعیِ شنیدنِ
  // قسمت‌ها دو ایراد را نشان داد که هیچ‌کدام با قاعده‌های کلی درست نشدند —
  // «آ»/«ا» به شکلِ افغانی و تاجیکی («آب» شبیهِ «اوب»)، و واکه‌های کوتاهی که
  // ادا نمی‌شدند. مدلِ گفتار به دستورِ *مشخص با مثالِ غلط و درست* بهتر جواب
  // می‌دهد تا به توصیهٔ کلی. پس اول‌ترین و پرتأکیدترین قاعده، همان است که
  // بیشتر شکسته می‌شود.
  // ══ چرا دستورِ گفتار این‌قدر کوتاه شد ══
  //
  // تا نسخهٔ ۵٫۸ پیش از هر تکهٔ صوت، یک دستورِ بلندِ چندبندی (نزدیک به دو
  // هزار نویسه: قاعده‌های تلفظ با مثالِ غلط و درست، قاعده‌های اجرا، و یک
  // دنبالهٔ تأکیدی) به Gemini فرستاده می‌شد و متنِ اصلی تهِ آن بود. مدلِ
  // گفتارِ Gemini یک «متنِ برای گفتن» می‌گیرد و دستورِ لحن را باید خودش از
  // همان متن تشخیص بدهد؛ وقتی دستور از خودِ متن بلندتر باشد، دو اتفاق
  // می‌افتد که هر دو در قسمت‌های واقعی شنیده شد:
  //   ۱) گاهی مدل به‌جای اجرا، خودِ دستور را بلند می‌خوانَد — همان فاجعه‌ای
  //      که در یک درس‌نامه و یک قسمتِ متنوع وسطِ صدا پخش شد.
  //   ۲) کیفیتِ تلفظ در تکه‌های بعدی افت می‌کند، چون هر تکه دوباره با همان
  //      کوهِ دستور شروع می‌شود و سهمِ توجهِ مدل از متنِ واقعی کم می‌شود.
  //
  // درمانِ ریشه‌ای دو تکه است: دستورِ هر تکه حداکثر «یک سطرِ کوتاه» است
  // (در ttsCue_ ساخته می‌شود و سقفش TTS_CUE_MAX است)، و درست‌خوانی به‌جای
  // دستور، از خودِ متن می‌آید — متنِ صوتی از این نسخه اعراب‌گذاریِ کامل
  // دارد (فتحه، کسره، ضمه، سکون) پس دیگر نیازی به آن مثال‌های غلط و درست
  // نیست. این رشتهٔ کوتاه فقط هویتِ گوینده را می‌دهد.
  // لهجه در همین سطر می‌آید، نه در یادآورِ شرطیِ پایین.
  //
  // چرا: یادآورِ تلفظ فقط وقتی فرستاده می‌شد که متن اعراب نداشته باشد، با این
  // استدلال که «متنِ اعراب‌دار خودش راهنمای تلفظ است». آن استدلال برای صدای
  // کوتاه (زیر و زبر و پیش) درست است و برای لهجه غلط: اعراب هیچ‌جا نمی‌گوید
  // «ا» را ایرانی ادا کن یا افغانی. نتیجه‌اش این شد که از وقتی متنِ صوتی
  // اعراب‌دار شد، دقیقاً همان دستوری که جلوی این اشتباه را می‌گرفت خاموش ماند —
  // و گزارشِ کاربر همین بود: «بابا» را baawbaaw می‌خواند.
  TTS_STYLE_BASE: 'گویندهٔ حرفه‌ایِ رادیوی ایران، فارسیِ معیارِ تهرانی. ' +
                  'الف را باز و کوتاه بگو، نه کشیده و گِرد — نه لهجهٔ افغانی',

  // یادآورِ تلفظ برای متنی که (به هر دلیل) بی‌اعراب مانده — باز هم کوتاه.
  // این یکی همچنان شرطی است و درست هم هست: فقط دربارهٔ صدای کوتاه حرف می‌زند،
  // و متنِ اعراب‌دار واقعاً خودش آن را می‌گوید.
  TTS_PRON_HINT: 'زیر و زبر و پیشِ حروف را کامل ادا کن',

  // سقفِ طولِ کلِ سطرِ دستور. اگر لحنِ بخش بلندتر باشد، بریده می‌شود —
  // دستورِ بلند دشمنِ اجراست، نه کمکش.
  // سقف کمی بالا رفت چون لهجه به سطرِ پایه اضافه شد، ولی عمداً کم — نگهبانِ
  // «دستور باید کوتاه بماند» همان چیزی است که جلوی خوانده‌شدنش را می‌گیرد.
  // بریدن از ته انجام می‌شود، پس اگر لحنِ بخش بلند باشد همان بریده می‌شود نه
  // لهجه؛ و این ترتیبِ درستی است: لهجهٔ غلط از لحنِ ناکامل بدتر است.
  TTS_CUE_MAX: 320,

  // هر بار که سطرِ دستور همراهِ متن فرستاده شود، یک شانسِ تازه است که مدل
  // به‌جای اجرا، خودش را بخواند. این بارها گزارش شد: «گوینده وسطِ متن، دستورِ
  // لحن را هم می‌خواند». کوتاه‌کردنِ دستور کمش کرد ولی تمامش نکرد — چون تعدادِ
  // دفعات دست‌نخورده ماند: یک قسمتِ ۱۴ دقیقه‌ای بیش از ده تکه دارد و هر تکه
  // دستورِ خودش را می‌گرفت.
  //
  //   'perSection' (پیش‌فرض) — دستور فقط در نخستین تکهٔ هر لحن. تا وقتی لحن
  //        عوض نشده، تکه‌های بعدی متنِ خالی می‌گیرند. صدا از voiceConfig می‌آید،
  //        نه از دستور، پس گوینده عوض نمی‌شود.
  //   'perChunk'   — رفتارِ قدیمی؛ برای مقایسه نگه داشته شده.
  TTS_CUE_MODE: 'perSection',


  // سازگاری با کدها و آزمون‌های قدیمی؛ در ساختِ صدا دیگر استفاده نمی‌شود.
  TTS_STYLE_TAIL: '',

  // متنِ صوتیِ اعراب‌دار (فتحه/کسره/ضمه/سکون، تلفظِ تهرانی) پیش از صداگذاری
  // ساخته می‌شود؛ اول از پاسخِ Cowork، وگرنه با مدل — و همیشه با وارسیِ
  // «واژه‌به‌واژه همان متن است». false یعنی مثل قبل با متنِ ساده بخوان.
  TASHKIL_ENABLED: true,

  TTS_CHUNK_CHARS: 1100,       // حداکثر طول هر تکه متن ارسالی به TTS
  // وقتی که باید برای «یک تکهٔ صوتیِ دیگر» کنار گذاشته شود.
  // چرا: حلقهٔ صداگذاری فقط *پیش از شروعِ* هر تکه ساعت را می‌دید. اگر ساعت
  // چند ثانیه به مهلت مانده بود، تکهٔ تازه شروع می‌شد و یک فراخوانِ گفتارسازی
  // می‌تواند بیش از یک دقیقه طول بکشد — یعنی ردشدن از سقفِ شش‌دقیقه‌ایِ گوگل و
  // پیامِ «Exceeded maximum execution time». حالا تکهٔ تازه فقط وقتی شروع
  // می‌شود که وقتِ تمام‌کردنش هم باشد.
  TTS_RESERVE_MS: 110000,
  // و ادغام هم یک عملیاتِ تک‌تکه و نابخش‌پذیر است: اگر وسطش مهلت تمام شود،
  // هیچ راهی برای ادامه نیست. با سقفِ پایین‌تر، قسمت‌های بلند تکه‌تکه می‌مانند
  // (که مشکلی نیست) به‌جای اینکه کلِ اجرا کشته شود.
  MERGE_RESERVE_MS: 150000,
  SAMPLE_RATE: 24000,          // خروجی Gemini TTS: PCM 24kHz، ۱۶ بیت، تک‌کاناله
  MAX_WAV_BYTES: 10000000,     // ~۳٫۵ دقیقه در هر فایل؛ قسمت بلندتر به چند بخش نوشته می‌شود

  // پس از آماده‌شدن بخش‌ها، یک فایل یکجا هم ساخته می‌شود تا تلگرام کل قسمت را
  // در یک فایل بفرستد. سقف آپلود ربات تلگرام پنجاه مگابایت است.
  MERGE_AUDIO: true,
  // سقفِ هر فایلِ یکجا. تلگرام تا پنجاه مگابایت را می‌پذیرد، ولی محدودیتِ
  // واقعیِ ما تلگرام نیست: خودِ Apps Script است. چسباندن در حافظه انجام
  // می‌شود و رشتهٔ base64 چهار سومِ حجمِ فایل است. تجربهٔ ۱۲ مرداد: ادغامِ
  // ۳۸ مگابایت (درس‌نامه) سالم تمام شد و ادغامِ ۴۱٫۷ مگابایت (برنامهٔ متنوع،
  // هفت بخش) اجرا را کشت — بی هیچ استثنای قابلِ گرفتن و بی هیچ سطری در سیاهه.
  // پس سقف را زیرِ آن مرز می‌گذاریم: ~۱۱ دقیقه در هر فایل. قسمتِ بلندتر دو
  // فایلِ متوازن می‌شود، که از یک ادغامِ کشته‌شده بی‌نهایت بهتر است.
  // ۱۲ مرداد ۳۸ مگابایت سالم ادغام شد و ۴۱٫۷ اجرا را کشت. ۳۶ زیرِ آن مرز است
  // و همچنان حاشیه دارد — و همین ~۱٫۵ دقیقه بیشتر، مرزِ «یک فایل» را از ۱۱٫۴ به
  // ۱۲٫۵ دقیقه می‌برد که تقریباً همهٔ قسمت‌های واقعی را پوشش می‌دهد.
  MERGE_MAX_BYTES: 36000000,

  // نرخِ گفتارِ فارسیِ این گوینده: نویسه بر ثانیه. از هدفِ ۱۰ دقیقه/۱۵۰۰ واژه
  // به دست آمده (۱۵۰ واژه در دقیقه × ~۵٫۵ نویسه = ~۱۳٫۷). فقط برای تخمینِ
  // پیش از ساخت به کار می‌رود، نه برای چیزی که باید دقیق باشد.
  SPEECH_CHARS_PER_SEC: 13.7,

  // «یک فایلِ واحد» خواستهٔ صریحِ صاحبِ برنامه است: دو تکه، کارِ حرفه‌ای به نظر
  // نمی‌رسد. مرزش را حدس نمی‌زنیم — از همان MERGE_MAX_BYTES و نرخِ گفتار حساب
  // می‌شود (oneFileMaxChars_). قسمتی که از این بلندتر شود، ناگزیر دو فایل است.
  // ── بانکِ موسیقی و افکت (بخشِ ۲۳) ──
  // فایل‌ها در پوشه‌ای در OUTPUT می‌نشینند و فهرستشان در تبِ «موسیقی» است.
  // فقط WAV؛ رمزگشاییِ MP3 در Apps Script ممکن نیست.
  MUSIC_ENABLED: true,
  // خودکار یعنی مدل خودش حال‌وهوا و قطعه و جایِ برش را تعیین کند. خاموش که
  // شود، فقط ستون‌هایی که آدم در تب پر کرده ملاک است.
  MUSIC_AUTO: true,
  MUSIC_FOLDER: 'موسیقی و افکت',
  MUSE_TAB: 'کاربردِ موسیقی',   // تاریخچهٔ پخش: کدام قطعه، کدام قسمت، کدام جایگاه
  MUSIC_TAB: 'موسیقی',
  MUSIC_INTRO_SEC: 8,          // طولِ موسیقیِ آغاز
  MUSIC_OUTRO_SEC: 10,         // طولِ موسیقیِ پایان
  MUSIC_BRIDGE_SEC: 4,         // طولِ قطعهٔ میانه
  MUSIC_BRIDGE_EVERY: 4,            // (کهنه — از ۵٫۵۰ جای موسیقی از مرزِ بخش‌ها می‌آید)
  MUSIC_BRIDGE_MAX: 2,              // حداکثر قطعهٔ میانه در یک قسمت
       // هر چند تکه یک میانه؛ صفر یعنی هیچ
  MUSIC_FADE_SEC: 2,           // محوِ نرمِ ابتدا و انتهای هر قطعه
  MUSIC_GAIN: 0.8,             // ضریبِ بلندیِ کلی، روی بلندیِ خودِ ردیف
  MUSIC_MAX_CLIP_SEC: 45,      // سقفِ هر برش — نگهبانِ حافظه و زمان

  // ── افکتِ صوتی: عمداً سخت‌گیر ──
  // اگر معیار «آمدنِ یک واژه» باشد، هر اشارهٔ گذرا به باران یک صدای باران
  // می‌سازد؛ مصنوعی می‌شود و در درس‌نامه فاجعه است. پس واژه باید ساختاری
  // باشد (در سرِ بخش، یا دستِ‌کم دو بار در همان بخش) و سقفِ هر قسمت هم سخت.
  MUSIC_SFX_ENABLED: true,
  MUSIC_SFX_IN_SPECIAL: false, // درس‌نامه شمرده و بی‌جلوه است
  MUSIC_SFX_MAX_PER_EP: 1,     // حتی اگر ده جای مناسب باشد، یکی

  ONE_FILE_STRICT: true,

  // «درس‌نامه» هدفش ۱۵ دقیقه است ≈ ۴۳ مگابایت — بالاتر از سقفِ ادغام، پس
  // ناگزیر دو فایل می‌شود. یک‌فایلی‌کردنش یعنی کوتاه‌کردنِ درس به ~۱۱٫۵ دقیقه،
  // و این تصمیمِ محتوایی است نه فنی؛ پس خاموش می‌ماند تا صاحبِ برنامه بخواهد.
  // روشن که شود، سقفِ نویسهٔ درس‌نامه هم خودبه‌خود پایین می‌آید.
  // صاحبِ برنامه صریح گفت درس‌نامه هم باید یک فایل باشد. با روشن‌بودنش سقفِ
  // نویسهٔ درس‌نامه خودبه‌خود به اندازهٔ یک فایل می‌آید (specialMaxChars_)، پس
  // درس کوتاه‌تر می‌شود و در یک فایل جا می‌گیرد.
  SPECIAL_ONE_FILE: true,


  // ---- فایل‌های تکه‌تکه‌شده ----
  // در شیت‌های تازه، فایل بزرگ تکه‌تکه تحلیل شده و هر قطعه یک ردیف است. قطعه‌ها
  // در یک تبِ موقت انبار می‌شوند و وقتی همهٔ قطعه‌های یک فایل رسید (یا ردیف
  // جمع‌بندی‌اش آمد) به یک آیتمِ واحد تبدیل می‌شوند. این‌طور یک کتابِ ۵۳ قطعه‌ای
  // یک آیتم می‌شود، نه ۵۳ تا — و ترتیب قطعه‌ها هم حفظ می‌شود.
  CHUNK_WAIT_HOURS: 18,        // اگر جمع‌بندی نرسید، بعد از این مدت با همان قطعه‌ها بساز

  // بیشترین قطعه‌ای که از یک فایل انبار می‌شود. بزرگ‌ترین فایلِ فعلی پنجاه‌وسه
  // قطعه دارد، پس این سقف امروز هیچ چیزی را کم نمی‌کند؛ ولی اگر روزی فایلی
  // پانصد قطعه‌ای بیاید، به‌جای پانصد ردیف، شصت قطعهٔ نمونه از سراسرِ فایل
  // (با گام یکنواخت، به‌علاوهٔ قطعهٔ آخر) انبار می‌شود — پوششِ کل فایل حفظ
  // می‌شود و تبِ انبار از کنترل خارج نمی‌شود.
  CHUNK_MAX_PER_FILE: 60,

  // ---- پادکست تخصصیِ مجموعه‌های آموزشی ----
  // فقط شیت‌هایی که فایل‌های بلندِ آموزشی دارند برای «مجموعه» اسکن می‌شوند.
  // دو شیت اولِ کلیپ‌کوتاه و عکس این‌جا جایی ندارند.
  SERIES_SOURCES: ['general', 'trading', 'resvid'],
  SPECIAL_ENABLED: true,
  SPECIAL_HOUR: 8,                  // ساعت تولید روزانه به وقت دبی
  SPECIAL_TARGET_MINUTES: 15,       // طول هدف هر قسمت
  // بودجهٔ متنِ خامِ درس در هر قسمت. پانزده دقیقه گفتار ≈ ۲۲۰۰ واژه ≈ ۱۳٬۰۰۰ نویسه
  // خروجی؛ برای نوشتنِ وفادار و بدون فشرده‌سازیِ بی‌جا، حدود سه برابرش متنِ ورودی
  // لازم است. این عدد سقفِ متنِ قطعه‌هایی است که در یک قسمت پوشش داده می‌شوند.
  SPECIAL_SOURCE_CHARS: 42000,
  SPECIAL_MIN_CHUNKS: 3,            // کف: قسمت با کمتر از این تعداد قطعه ساخته نمی‌شود
  // سقفِ متنِ یک قطعه در یک قسمت. قطعهٔ بلندتر بریده نمی‌شود؛ به چند «برش»
  // تقسیم می‌شود و برش‌های بعدی به قسمت‌های بعدیِ پادکست می‌روند. بی این،
  // یک قطعهٔ نودهزار نویسه‌ای به دوازده‌هزار بریده می‌شد و بقیه‌اش برای همیشه
  // پشتِ مکان‌نما جا می‌ماند — دقیقاً همان «هرز رفتنِ محتوا» که نباید بشود.
  SPECIAL_CHUNK_CHARS: 14000,
  SPECIAL_BUDGET_SLACK: 1.15,       // سقفِ سختِ متنِ ورودیِ یک قسمت (نسبت به بودجه)
  SPECIAL_MIN_OUTPUT_RATIO: 0.4,    // اگر متنِ خروجی کمتر از این نسبتِ هدف بود، ناقص است
  SPECIAL_STUCK_LIMIT: 2,           // بعد از این تعداد قسمتِ بی‌پیشرفت، به‌زور جلو می‌رویم
  SPECIAL_MAX_CHUNKS: 40,           // سقف قطعه در یک قسمت، حتی اگر متنشان کوتاه باشد
  SPECIAL_SECTIONS: 6,              // تعداد بخش‌های هدف در متن قسمت تخصصی
  SPECIAL_ENRICH: 8,                // چند آیتمِ مکمل از سایر شیت‌ها برای تعمیق
  SPECIAL_ENRICH_MIN_SCORE: 3,      // کف امتیاز شباهت برای پذیرفتن یک آیتم مکمل
  SPECIAL_RECAP_EPISODES: 4,        // مرور چند قسمت قبل در آغاز هر قسمت
  SERIES_MIN_CHUNKS: 4,             // فایلی با کمتر از این قطعه، «مجموعهٔ آموزشی» نیست
  // فایلِ «تنها» (بی قسمتِ دوم) باید واقعاً بلند باشد تا دوره حساب شود؛ وگرنه
  // هر کلیپِ چندقطعه‌ای یک «مجموعه» می‌شد و فهرست از دستِ آدم خارج می‌شد.
  SERIES_MIN_SOLO_CHUNKS: 8,

  // ---- داوریِ محتوایی مجموعه‌ها (نسخهٔ ۵٫۲) ----
  // تشخیصِ «آموزشی بودن» و دسته و سطح، از خواندنِ متنِ واقعیِ قطعه‌ها می‌آید.
  // نام فایل فقط یک نشانهٔ فرعی است: آرشیو پر است از فایل‌هایی که اسمشان چیزی
  // می‌گوید و محتوایشان چیز دیگری است.
  JUDGE_BATCH: 3,                   // چند مجموعه در یک فراخوانِ مدل داوری شود
  JUDGE_BATCHES_PER_RUN: 40,        // سقفِ فراخوان در هر اجرا؛ در عمل «مهلت» تعیین‌کننده است
  JUDGE_SAMPLES: 3,                 // چند قطعه از هر مجموعه نمونه‌برداری شود
  JUDGE_SAMPLE_CHARS: 2600,         // سقفِ نویسهٔ هر نمونه
  // سقفِ توکنِ خروجیِ داوری. با ۸۱۹۲، «فکرکردنِ» مدل کلِ سهم را می‌خورد و پاسخ
  // بی‌متن برمی‌گشت؛ همان چیزی که داوری را سه بار پشت سر هم صفر کرد.
  JUDGE_MAX_TOKENS: 24576,

  // ---- داوریِ بی‌مدل: پشتیبانی که هرگز صفر نمی‌ماند (نسخهٔ ۵٫۴) ----
  // اگر مدل جواب ندهد — پاسخِ بی‌متن، صافیِ محتوا، سقفِ سهمیه — داوری روی همان
  // متنی که قبلاً خوانده شده با قاعده‌های صریح انجام می‌شود. کیفیتش کمتر از
  // مدل است، ولی فهرست بی‌نظم و بی‌دسته نمی‌ماند و هیچ‌وقت «۰ از ۲۶۳» نمی‌شود.
  JUDGE_LOCAL_FALLBACK: true,
  JUDGE_LOCAL_DAYS: 3,              // داوریِ بی‌مدل زود دوباره با مدل امتحان می‌شود
  JUDGE_NOAI_MIN: 30,               // بعد از شکستِ مدل، این‌قدر دقیقه سراغش نمی‌رویم
  JUDGE_LOCAL_MAX: 500,             // سقفِ داوریِ بی‌مدل در یک اجرا
  JUDGE_LOCAL_SAMPLE_CHARS: 1600,   // نمونهٔ کوچک‌ترِ حالتِ بی‌مدل (سریع‌تر)
  // «متوسط»: هر چیزی که آموختنِ منظم دارد آموزشی است — سخنرانیِ تخصصی و
  // مصاحبهٔ عمیق هم بله؛ روضه و سینه‌زنی و مناسبت و کلیپ خبری نه.
  JUDGE_STRICTNESS: 'medium',
  JUDGE_MIN_SCORE: 45,              // کف امتیازِ آموزشی برای ورود به «درس‌نامه»
  JUDGE_REJUDGE_DAYS: 45,           // داوریِ کهنه‌تر از این، دوباره انجام می‌شود
  JUDGE_UNSURE_DAYS: 2,             // داوریِ «مشکوک» زودتر دوباره امتحان می‌شود
  JUDGE_MIN_SAMPLE_CHARS: 900,      // کمتر از این نویسه، نمونه کافی نیست
  SERIES_RESCAN_HOURS: 12,          // هر چند ساعت رجیستری مجموعه‌ها دوباره ساخته شود
  // اگر تولید چیزی برای ساختن پیدا نکرد، رجیستری همان لحظه به‌زور تازه می‌شود —
  // تا دوره‌ای که همین امروز اضافه شده، پشتِ سقفِ دوازده‌ساعته جا نماند.
  SERIES_FORCE_ON_IDLE: true,

  ALERT_NO_EPISODE_HOURS: 30,  // اگر بیش از این مدت قسمتی ساخته نشد، هشدار بده
  ALERT_NO_SPECIAL_HOURS: 30,  // همان، برای پادکست تخصصی
  ALERT_SYNC_BEHIND: 2000,     // اگر همگام‌سازی این‌قدر ردیف عقب افتاد، هشدار بده

  // ---- دیدبانی خودِ شیت‌های منبع ----
  // آستانهٔ «راکد» و «کم‌کار» ثابت نیست: از فاصلهٔ معمولِ خودِ همان تب حساب
  // می‌شود (شش برابر و سه برابر). این دو عدد فقط کفِ آن آستانه‌اند تا تبی که
  // ساعتی ردیف می‌گیرد، با چند ساعت وقفه «راکد» اعلام نشود.
  // آستانه = «سکوتِ معمولِ خودِ آن تب» × ضریب. برای تبی که ساعتی ردیف می‌گیرد
  // این چند روز می‌شود و برای تبی که هفته‌ای یک‌بار دسته‌ای کار می‌کند، چند هفته.
  PULSE_STALL_FACTOR: 2.5,     // ضریبِ «راکد»
  PULSE_SLOW_FACTOR: 1.4,      // ضریبِ «کم‌کار»
  PULSE_MIN_STALL_DAYS: 2,     // کفِ آستانهٔ «راکد» (برای تب‌های پرترافیک)
  PULSE_MIN_SLOW_DAYS: 1,      // کفِ آستانهٔ «کم‌کار»
  PULSE_MAX_STALL_DAYS: 60,    // سقف، تا یک وقفهٔ تاریخیِ بلند آستانه را بی‌نهایت نکند
  PULSE_UNKNOWN_STALL_DAYS: 14, // وقتی هنوز الگوی تب شناخته نیست (همه‌چیز در یکی دو روز آمده)
  // افتِ ظرفیت: اگر میانهٔ ردیف‌در‌روزِ هفتهٔ اخیر کمتر از این نسبت از دورهٔ
  // پیش از آن شود، «کم‌کار» اعلام می‌شود — حتی اگر هنوز قطره‌قطره ردیف بیاید.
  PULSE_SLOW_RATIO: 0.25,

  // ---- نام تب‌ها ----
  TAB_INDEX: '_داشبورد',
  TAB_PODCASTS: 'پادکست‌ها',
  TAB_LOG: '_گزارش',
  TAB_PRON: 'تلفظ',
  TAB_AUDIT: 'سنجهٔ محتوا',     // نتیجهٔ مقایسهٔ متنِ نهایی با متن‌های خام
  CAL_TAB: 'تقویمِ تولید',      // روزهای تولیدِ هر برنامه و استثناها
  CHUNK_TAB: '_قطعات',         // انبار موقت قطعه‌های فایل‌های بزرگ
  SRC_ERR_TAB: '_خطاهای منبع', // ردیف‌هایی که خط لولهٔ شما در آن‌ها خطا نوشته
  PULSE_TAB: '_نبض منابع',     // فعالیت هر تب منبع و تشخیص رکود
  REPORT_TAB: 'گزارش‌های نظارت', // گزارش روزانهٔ Cowork و اقدام‌هایی که روی آن شد
  SERIES_TAB: '_مجموعه‌های آموزشی',  // رجیستری مجموعه‌ها و جای ایستادنِ هر کدام
  SERIES_PART_TAB: '_قسمت‌های مجموعه', // هر ردیف یک فایل (یک قسمتِ درس) با نشانیِ قطعه‌هایش
  SPECIAL_TAB: 'پادکست تخصصی',      // قسمت‌های تولیدشدهٔ برنامهٔ درس‌نامه
  EXTSRC_TAB: '_منابع بیرونی',      // هر منبعِ اینترنتیِ افزوده، با لینکِ دقیق

  // ---- فولدربندی در درایو ----
  // دو برنامه هرگز نباید در یک پوشه قاطی شوند، و هر مجموعهٔ آموزشی پوشهٔ
  // شماره‌دارِ خودش را می‌گیرد تا دو مجموعه هم روی هم نیفتند.
  VARIETY_FOLDER: 'پادکست — از همه جا از همه رنگ',
  SPECIAL_FOLDER: 'پادکست تخصصی — درس‌نامه',

  // ---- حلقهٔ بستهٔ گزارش ← اقدام ----
  // نسخهٔ کدی که همین حالا در Apps Script چسبانده‌اید. Cowork پس از ساخت کد
  // تازه، فایل زیر را در OUTPUT می‌نویسد؛ موتور این دو را می‌سنجد و اگر عقب
  // بود، ردیف «نیازمند تعویض کد» ثبت و پیام تلگرام ارسال می‌کند.
  // ---- غنی‌سازیِ اینترنتی، پیش از صداگذاری (نسخهٔ ۵٫۵) ----
  // متنِ قسمت پیش از ساختِ صدا برای Cowork گذاشته می‌شود تا با جست‌وجوی وب
  // تکمیل و تعمیق شود. جزئیاتِ قرارداد در 19_Enrich.gs.
  ENRICH_ENABLED: true,
  ENRICH_WAIT_MIN: 90,              // حداکثر انتظار برای پاسخ؛ بعدش بی‌غنی‌سازی جلو
  ENRICH_POLL_MIN: 10,              // هر چند دقیقه سری به پوشه زده شود
  // سهمیه‌ها: محتوای اصلی باید غالب بماند. «بیرونی» = آمده از اینترنت،
  // «توضیحی» = مثال و مفهومی‌کردنِ همان محتوای اصلی.
  ENRICH_MAX_OUTSIDE_PCT: 15,
  ENRICH_MAX_INSIDE_PCT: 15,
  ENRICH_MAX_TOTAL_PCT: 25,
  ENRICH_KEEP_DAYS: 10,             // پرونده‌های دستِ‌به‌دستِ کهنه پاک می‌شوند

  // ------------------------------------------- دیدبانِ محتوا (بخش ۲۴)
  // پاسِ وفاداریِ زمانِ تولید واژه‌ای است: نقل‌قولِ بی‌پشتوانه و جملهٔ بلند را
  // می‌گیرد، ولی نمی‌تواند بگوید «این عکس اصلاً به این بخش نمی‌خورد» یا
  // «پیوندِ این دو آیتم ساختگی است». آن دو قضاوتِ معنایی‌اند و مدل باید
  // بکندشان — ولی نه وسطِ تولید (وقت ندارد و اگر بد جواب دهد قسمت را خراب
  // می‌کند). پس متنِ نهایی و متن‌های خام همان لحظه عکس‌برداری می‌شوند و
  // داوری فردا، سرِ فرصت، انجام می‌گیرد.
  // تقویمِ تولید (بخشِ ۲۵). خاموش‌کردنش یعنی تقویم نادیده گرفته شود و همه‌چیز
  // مثلِ قبل هر روز ساخته شود.
  CAL_ENABLED: true,

  AUDIT_ENABLED: true,
  AUDIT_FOLDER: 'بایگانی — سنجهٔ محتوا',
  AUDIT_MAX_PER_RUN: 3,             // سقفِ قسمت در هر دور (مهلتِ شش‌دقیقه‌ای)
  AUDIT_BODY_MAX: 1200,             // سقفِ نویسهٔ هر متنِ خام در عکس
  AUDIT_NARR_MAX: 4000,             // سقفِ نویسهٔ روایتِ هر بخش در عکس
  AUDIT_KEEP_DAYS: 45,
  // زیر این درصدِ اِسناد، ایراد از خودِ موتور است نه از مدل: یعنی بخش‌ها
  // اصلاً منبعی به خود نگرفته‌اند و مقایسه بی‌معنی می‌شود.
  AUDIT_MIN_ATTRIB_PCT: 60,
  // چند شبِ پیاپیِ بدِ اِسناد تا «ایرادِ کدِ موتور» اعلام شود (یک شب می‌تواند
  // اتفاقی باشد؛ سه شب یعنی سازوکار خراب است).
  AUDIT_CODE_AFTER: 3,
  // ساعتِ آماده‌سازیِ متن (وقتِ دبی). عمداً چند ساعت پیش از انتشار، تا پنجرهٔ
  // جست‌وجوی Cowork جا داشته باشد و ساعتِ رسیدنِ پادکست عوض نشود.
  PREPARE_HOUR: 4,                  // متنِ «از همه جا از همه رنگ»
  PREPARE_SPECIAL_HOUR: 5,          // متنِ «درس‌نامه»
  // ساعتِ انتشار — تا امروز در کد پراکنده بود؛ حالا یک‌جا، چون دروازهٔ
  // «نه پیش از ساعتِ مقرر» هم به آن تکیه می‌کند.
  EPISODE_HOUR: 7,

  CODE_VERSION: '5.52',
  CODE_FILE: '_CODE-LATEST.json',
  // ---- نصبِ خودکارِ کد (نسخهٔ ۵٫۱۰) ----
  // وقتی ناظرِ Cowork کدِ کاملِ تازه را با بیانیه‌اش در OUTPUT بگذارد، موتور
  // هر شب خودش وارسی و نصبش می‌کند (21_SelfUpdate.gs). خاموشش: false.
  AUTOUPDATE_ENABLED: true,
  UPDATE_HOUR: 2,                       // ساعتِ بررسیِ شبانه (دبی) — پیش از پشتیبانِ ۳
  CODE_FOLDER: 'کدها — نسخه‌های موتور', // بایگانیِ نسخه‌ها داخل OUTPUT؛ در پشتیبانِ شبانه هم می‌آید
  // ---- منبعِ کد: گیت‌هاب (نسخهٔ ۵٫۱۲) ----
  // موتور بیانیه و کدِ کامل را مستقیم از raw گیت‌هاب می‌خواند (ریپوی عمومی، بی‌توکن).
  // بعد از هر نصب، یک کپی هم در پوشهٔ «کدها»ی درایو می‌ماند. برای برگشت به روشِ
  // درایو، CODE_SOURCE را 'drive' کن (کدِ قدیم دست‌نخورده پشتیبان است).
  CODE_SOURCE: 'github',                // 'github' | 'drive'
  GITHUB_OWNER: 'mahdighandi1989',
  GITHUB_REPO: 'Content-Engine',
  GITHUB_BRANCH: 'main',
  GITHUB_CODE_FILE: 'engine.gs',        // نامِ ثابتِ فایلِ کاملِ کد در ریشهٔ ریپو
  GITHUB_MANIFEST: 'manifest.json',     // بیانیه در ریشهٔ ریپو
  REPORT_FILE_PREFIX: '_REPORT-',   // نامِ فایل‌های گزارشِ Cowork در OUTPUT
  MAX_OPEN_INSTRUCTIONS: 12,        // حداکثر دستورِ بازِ تزریق‌شده به یک قسمت

  // ---------------------------------------------- مرتب نگه‌داشتنِ پوشهٔ OUTPUT
  // گزارشِ خوانده‌شده تا امروز برای همیشه در ریشه می‌ماند: روزی یک فایل، و
  // ریشه کم‌کم آن‌قدر شلوغ می‌شود که فایل‌های زندهٔ موتور در آن گم می‌شوند.
  // خوانده‌شده‌ها به این پوشه می‌روند. جست‌وجوی گزارشِ تازه فقط ریشه را
  // می‌گردد و اسمِ «.ingested» را هم رد می‌کند، پس این جابه‌جایی چیزی را
  // نمی‌شکند — همان کاری را می‌کند که نامِ فایل از قبل اعلام کرده بود.
  REPORT_ARCHIVE_FOLDER: 'بایگانی — گزارش‌های خوانده‌شده',
  REPORT_KEEP_DAYS: 60,             // بایگانیِ قدیمی‌تر از این پاک می‌شود (۰ = هرگز)
  // پرامپت‌ها append-only هستند، پس ریشه با هر به‌روزرسانی یک فایل شلوغ‌تر
  // می‌شد. فقط بالاترین نسخه در ریشه می‌ماند؛ بقیه اینجا — پاک نمی‌شوند.
  PROMPT_ARCHIVE_FOLDER: 'بایگانی — پرامپت‌های پیشین',
  OUT_TIDY: true,                   // بایگانی و هرسِ خودکار

  // نقشهٔ پوشه: منبعِ حقیقتش در ریپوست و موتور شبانه در OUTPUT بازتابش می‌دهد،
  // تا «هر تغییری هم در گیت‌هاب ثبت شود هم آنجا» خودبه‌خود برقرار بماند.
  OUT_README: 'README — نقشهٔ پوشهٔ OUTPUT.md',
  OUT_README_PATH: 'docs/drive_layout.md',

  // نامِ پوشهٔ نمونه‌های صدا — تا وارسیِ چیدمان و خودِ آزمون یک اسم را بگویند
  VOICE_AUDIT_FOLDER: 'آزمونِ صدای گویندگان',
  MUSIC_WISH_FILE: '_MUSIC-WISH.json'
