  MUSIC_SFX_PREFETCH: true,
  MUSIC_SFX_PREFETCH_MS: 90000,
  MUSIC_SFX_PREFETCH_MAX: 2,   // حداکثر فایل در همین پنجره
  // ── بازبینیِ شنیداریِ خودکار ──
