    },
    outro: { type: 'string' },
    summary: { type: 'string' },
    tags: { type: 'array', items: { type: 'string' } },
    coverage: { type: 'string' }
  },
  required: ['title', 'hook', 'goal', 'sections', 'outro', 'summary']
};

function buildSpecialPrompt_(ctx) {
  var L = [];
