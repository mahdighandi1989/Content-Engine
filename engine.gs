  //   'highest' = بالاترین مدل ممکن، حتی اگر پیش‌نمایش (preview) باشد — کیفیت بیشتر
  //   'stable'  = فقط نسخه‌های پایدار — پایداری بیشتر، کیفیت کمی کمتر
  // در هر دو حالت اگر مدلی بازنشسته شود، جانشینش خودکار انتخاب می‌شود.
  MODEL_POLICY: 'highest',
  /* داوریِ تعویضِ مدل (۶٫۱۶): مدلِ متنی روی هر جملهٔ هر قسمت اثر می‌گذارد —
     پرخطرترین تغییرِ ممکن، و تا ۶٫۱۵ تنها تغییری که هیچ داوری‌ای نداشت. */
  MODEL_VERDICT_HOURS: 48,

  /* ── نظارتِ کیفیِ استخراج (۶٫۱۷، بخشِ ۲۸) ──
     هفتگی، نه هر شب: کیفیتِ یک استخراج‌گر در بیست‌وچهار ساعت عوض نمی‌شود و
     نظارتی که هر شب بدود هم سهمیه می‌خورد هم نویز می‌سازد. */
  SQ_ENABLED: true,
  SQ_TAB: 'کیفیتِ استخراج',
  SQ_EVERY_DAYS: 7,
  SQ_SAMPLE: 12,               // چند ردیفِ تازه نمونه گرفته شود
  SQ_MIN_ROWS: 5,              // زیرِ این، داوری انجام نمی‌شود
  SQ_EMPTY_MAX: 40,            // درصدِ خانه‌های خالی که «جدی» می‌شود
  SQ_DUP_MAX: 25,              // درصدِ ردیف‌های عیناً تکراری
  SQ_MS: 120000,

  // ---- هویتِ دو برنامه ----
  // برنامهٔ روزانهٔ متنوع: از تلفیقِ کلیپ و صدا و عکس و سند ساخته می‌شود.
  SHOW_NAME: 'از همه جا از همه رنگ',
  SHOW_TAGLINE: 'برنامهٔ روزانهٔ آرشیو',
  // برنامهٔ تخصصی: روی مجموعه‌های آموزشیِ بلند و قطعه‌قطعه‌شده تمرکز دارد.
  SPECIAL_SHOW_NAME: 'درس‌نامه',
  SPECIAL_TAGLINE: 'پادکست تخصصیِ مجموعه‌های آموزشی',

  // یک گویندهٔ ثابت برای هر برنامه (مثل یک مجریِ واحد در رادیو).
  // تنوع باید از «نحوهٔ خواندن» بیاید نه از عوض‌شدن آدم — ولی دو برنامهٔ
  // متفاوت دو مجریِ متفاوت دارند تا از روی صدا فوراً تشخیص داده شوند.
  // این دو فقط «صدای پشتیبان»اند: اگر نقش‌گزینی به هر دلیل انجام نشود یا API
  // نامی را نپذیرد، اجرا با این‌ها ادامه می‌دهد. انتخابِ واقعیِ گوینده در
  // 20_Voices.gs بر پایهٔ محتوا و با گردشِ روزانه انجام می‌شود.
  TTS_VOICE: 'Charon',         // پشتیبانِ «از همه جا از همه رنگ»
  TTS_VOICE_SPECIAL: 'Kore',   // پشتیبانِ «درس‌نامه»
  // نقش‌گزینیِ چندصدایی: هر قسمت یک گویندهٔ اصلی و یک-دو همراه دارد، و انتخاب
  // از رویِ سرشتِ متن است. هیچ برنامه‌ای جنسیتِ ثابت ندارد.
  TTS_CAST_ENABLED: true,
  // اگر صدایی به گوشتان جور درنیامد، نامش را این‌جا (یا در ویژگیِ VOICE_BLOCK)
  // با کاما بنویسید تا دیگر انتخاب نشود.
  TTS_VOICE_BLOCK: '',

  // پایهٔ لحن: هویت گوینده و قواعد تلفظ. در همهٔ بخش‌ها ثابت است.
  //
  // چرا این بخش این‌قدر سخت‌گیرانه و پرتکرار است: بازخوردِ واقعیِ شنیدنِ
  // قسمت‌ها دو ایراد را نشان داد که هیچ‌کدام با قاعده‌های کلی درست نشدند —
  // «آ»/«ا» به شکلِ افغانی و تاجیکی («آب» شبیهِ «اوب»)، و واکه‌های کوتاهی که
  // ادا نمی‌شدند. مدلِ گفتار به دستورِ *مشخص با مثالِ غلط و درست* بهتر جواب
  // می‌دهد تا به توصیهٔ کلی. پس اول‌ترین و پرتأکیدترین قاعده، همان است که
  // بیشتر شکسته می‌شود.
  // ══ چرا دستورِ گفتار این‌قدر کوتاه شد ══
  //
  // تا نسخهٔ ۵٫۸ پیش از هر تکهٔ صوت، یک دستورِ بلندِ چندبندی (نزدیک به دو
  // هزار نویسه: قاعده‌های تلفظ با مثالِ غلط و درست، قاعده‌های اجرا، و یک
  // دنبالهٔ تأکیدی) به Gemini فرستاده می‌شد و متنِ اصلی تهِ آن بود. مدلِ
  // گفتارِ Gemini یک «متنِ برای گفتن» می‌گیرد و دستورِ لحن را باید خودش از
  // همان متن تشخیص بدهد؛ وقتی دستور از خودِ متن بلندتر باشد، دو اتفاق
  // می‌افتد که هر دو در قسمت‌های واقعی شنیده شد:
  //   ۱) گاهی مدل به‌جای اجرا، خودِ دستور را بلند می‌خوانَد — همان فاجعه‌ای
  //      که در یک درس‌نامه و یک قسمتِ متنوع وسطِ صدا پخش شد.
  //   ۲) کیفیتِ تلفظ در تکه‌های بعدی افت می‌کند، چون هر تکه دوباره با همان
  //      کوهِ دستور شروع می‌شود و سهمِ توجهِ مدل از متنِ واقعی کم می‌شود.
  //
  // درمانِ ریشه‌ای دو تکه است: دستورِ هر تکه حداکثر «یک سطرِ کوتاه» است
  // (در ttsCue_ ساخته می‌شود و سقفش TTS_CUE_MAX است)، و درست‌خوانی به‌جای
  // دستور، از خودِ متن می‌آید — متنِ صوتی از این نسخه اعراب‌گذاریِ کامل
  // دارد (فتحه، کسره، ضمه، سکون) پس دیگر نیازی به آن مثال‌های غلط و درست
  // نیست. این رشتهٔ کوتاه فقط هویتِ گوینده را می‌دهد.
  // لهجه در همین سطر می‌آید، نه در یادآورِ شرطیِ پایین.
  //
  // چرا: یادآورِ تلفظ فقط وقتی فرستاده می‌شد که متن اعراب نداشته باشد، با این
  // استدلال که «متنِ اعراب‌دار خودش راهنمای تلفظ است». آن استدلال برای صدای
  // کوتاه (زیر و زبر و پیش) درست است و برای لهجه غلط: اعراب هیچ‌جا نمی‌گوید
  // «ا» را ایرانی ادا کن یا افغانی. نتیجه‌اش این شد که از وقتی متنِ صوتی
  // اعراب‌دار شد، دقیقاً همان دستوری که جلوی این اشتباه را می‌گرفت خاموش ماند —
  // و گزارشِ کاربر همین بود: «بابا» را baawbaaw می‌خواند.
  TTS_STYLE_BASE: 'گویندهٔ حرفه‌ایِ رادیوی ایران، فارسیِ معیارِ تهرانی. ' +
                  'الف را باز و کوتاه بگو، نه کشیده و گِرد — نه لهجهٔ افغانی',

  // یادآورِ تلفظ برای متنی که (به هر دلیل) بی‌اعراب مانده — باز هم کوتاه.
  // این یکی همچنان شرطی است و درست هم هست: فقط دربارهٔ صدای کوتاه حرف می‌زند،
  // و متنِ اعراب‌دار واقعاً خودش آن را می‌گوید.
  TTS_PRON_HINT: 'زیر و زبر و پیشِ حروف را کامل ادا کن',

  // و یادآورِ «روان‌خوانی» برای متنی که *اعراب دارد*.
  //
  // چرا شرطش وارونهٔ بالایی است: گزارشِ کاربر این بود که «گویا جدا جدا روی
  // کلمات فقط تمرکز می‌کند». دقیقاً همان‌جا پیش می‌آید که متن پُر از نشانه
  // است — مدل هر واژه را با دقتِ املایی ادا می‌کند و پیوندِ عبارت را از دست
  // می‌دهد. پس یادآورِ پیوستگی جای همان‌جاست، نه جای متنِ خالی.
  TTS_FLOW_HINT: 'عبارت‌به‌عبارت و پیوسته بخوان نه واژه‌به‌واژه؛ مکث فقط جای نشانه‌ها',

  // سقفِ طولِ کلِ سطرِ دستور. اگر لحنِ بخش بلندتر باشد، بریده می‌شود —
  // دستورِ بلند دشمنِ اجراست، نه کمکش.
  // سقف کمی بالا رفت چون لهجه به سطرِ پایه اضافه شد، ولی عمداً کم — نگهبانِ
  // «دستور باید کوتاه بماند» همان چیزی است که جلوی خوانده‌شدنش را می‌گیرد.
  // بریدن از ته انجام می‌شود، پس اگر لحنِ بخش بلند باشد همان بریده می‌شود نه
  // لهجه؛ و این ترتیبِ درستی است: لهجهٔ غلط از لحنِ ناکامل بدتر است.
  TTS_CUE_MAX: 320,

  // هر بار که سطرِ دستور همراهِ متن فرستاده شود، یک شانسِ تازه است که مدل
  // به‌جای اجرا، خودش را بخواند. این بارها گزارش شد: «گوینده وسطِ متن، دستورِ
  // لحن را هم می‌خواند». کوتاه‌کردنِ دستور کمش کرد ولی تمامش نکرد — چون تعدادِ
  // دفعات دست‌نخورده ماند: یک قسمتِ ۱۴ دقیقه‌ای بیش از ده تکه دارد و هر تکه
  // دستورِ خودش را می‌گرفت.
  //
  //   'perSection' (پیش‌فرض) — دستور فقط در نخستین تکهٔ هر لحن. تا وقتی لحن
  //        عوض نشده، تکه‌های بعدی متنِ خالی می‌گیرند. صدا از voiceConfig می‌آید،
  //        نه از دستور، پس گوینده عوض نمی‌شود.
  //   'perChunk'   — رفتارِ قدیمی؛ برای مقایسه نگه داشته شده.
  // 'perSection' = سرِ هر بخش · 'always' = هر تکه · 'off' = هرگز.
  // «off» تنها حالتی است که *ساختاراً* ممکن نیست دستور خوانده شود، چون
  // اصلاً دستوری فرستاده نمی‌شود. بهایش لحنِ خنثی‌تر است.
  TTS_CUE_MODE: 'perSection',
  // پس از ساختِ هر تکه‌ای که دستور گرفته، شش ثانیهٔ اولش به مدل داده
  // می‌شود تا بگوید چه شنیده. اگر دستور خوانده شده باشد، همان تکه بی
  // دستور دوباره ساخته می‌شود. این تنها سنجه‌ای است که واقعاً می‌شنود؛
  // مقایسهٔ طول برای تکه‌های بلند قاطع نیست.
  TTS_CUE_VERIFY: true,
  TTS_CUE_VERIFY_SEC: 6,


  // سازگاری با کدها و آزمون‌های قدیمی؛ در ساختِ صدا دیگر استفاده نمی‌شود.
  TTS_STYLE_TAIL: '',

  // متنِ صوتیِ اعراب‌دار (فتحه/کسره/ضمه/سکون، تلفظِ تهرانی) پیش از صداگذاری
  // ساخته می‌شود؛ اول از پاسخِ Cowork، وگرنه با مدل — و همیشه با وارسیِ
  // «واژه‌به‌واژه همان متن است». false یعنی مثل قبل با متنِ ساده بخوان.
  TASHKIL_ENABLED: true,

  // ── بازبینیِ اجباریِ متنِ صوتی (۶٫۲۰) ──
  // «بعد از یک بار نوشته حتماً دقایقی بعدش مجدد بررسی بشه» — درخواستِ صریحِ
  // کاربر، و درست هم هست: هر سدی که تا امروز روی متنِ اعراب‌دار بود *ساختاری*
  // بود، نه معنایی. verifySpeak_ ثابت می‌کند همان واژه‌هاست و speakVowelledOk_
  // ثابت می‌کند نشانه کم نیست؛ هیچ‌کدام نمی‌گویند نشانه‌ها *درست*اند.
  // «بایستیم» با فتحه روی ب از هر دو سد رد می‌شود و در گوش «با» شنیده می‌شود.
  SPEAK_REVIEW: true,
  SPEAK_REVIEW_MIN: 3,         // چند دقیقه بعد از نوشتن، بازبینی شروع شود
  SPEAK_REVIEW_MAX: 14,        // سقفِ بخش‌هایی که در یک اجرا بازبینی می‌شوند

  // نشانه‌گذاریِ آوایی: مدل اجازه دارد «،» و «…» و «—» و «:» و نیم‌فاصله
  // اضافه/کم کند تا عبارت‌بندی درست شود. تا ۶٫۱۹ اجازه نداشت — نه به‌خاطرِ
  // قاعده‌ای، بلکه چون speakCmp_ نشانه‌ها را در مقایسه نگه می‌داشت و هر ویرگولِ
  // افزوده وارسی را می‌شکست؛ یعنی بخش با متنِ *بی‌اعراب* خوانده می‌شد.
  // ══ روشن، خاموش، و حالا روشنِ ایمن (۶٫۲۹) ══
  // ۶٫۲۶ این را خاموش کرد تا مدل نتواند نیم‌فاصلهٔ نابه‌جا بگذارد — ولی
  // پرامپت هنوز از مدل ویرگول و نیم‌فاصله می‌خواست و speakCmp_ هر دو را
  // ردّ می‌کرد. نتیجه در قسمتِ واقعی: از ۱۳ بخشِ «مرورِ بزرگ»، ۸ بخش
  // (۶۲٪) **بی هیچ اعرابی** خوانده شد و `__speakFails` روی ۱۸ ایستاد.
  // یعنی سدی که برای بهترکردنِ تلفظ گذاشته شده بود، تلفظ را از همیشه بدتر کرد.
  // حالا نیم‌فاصله و شکلِ حرف *تعمیر* می‌شوند نه ردّ (speakGraft_)، پس نشانه‌گذاریِ
  // آوایی — که خواستهٔ صریحِ صاحبِ برنامه بود — دوباره باز است.
  SPEAK_MARKS: true,

  // واژه‌هایی که بازبین «با اعراب هم درست خوانده نمی‌شوند» تشخیص می‌دهد، به تبِ
  // «تلفظ» افزوده می‌شوند تا برای همیشه اصلاح بمانند. فقط افزودن، هرگز
  // بازنویسیِ سطرِ آدمی؛ و فقط وقتی حروفِ جایگزین با حروفِ اصلی یکی باشد.
  SPEAK_LEARN: true,
  SPEAK_LEARN_MAX: 6,          // سقفِ سطرِ خودکار در هر قسمت

  // ── عصری‌سازیِ درس‌نامه (۶٫۲۱، بخشِ ۲۹) ──
  // «یه نفر غیر از اون گوینده در لا‌به‌لای هر مطلب بیاد توضیح بده … با
  // مثال‌های امروزی و ملموس». فقط درس‌نامه؛ «از همه جا از همه رنگ» این را
  // لازم ندارد و صریحاً خواسته نشده.
  EXPLAIN_ENABLED: true,
  // ۱۳ عددِ خودِ صاحبِ برنامه است: «شاید لازم باشه سهمیهٔ ۱۳ درصد … افزایش
  // پیدا کنه». روی *متنِ درس* حساب می‌شود نه روی سقفِ فایل — درسِ کوتاه
  // توضیحِ کوتاه می‌خواهد.
  /* ۱۳ ← ۲۰ (۶٫۴۳): «اون توضیحاتِ خودمونی و ساده و عصری‌سازی بینِ هر درس
     هم از این حالتِ خیلی مسخره و کوتاه و بی‌معنی در بیاد، خیلی بهتر بشه و
     ملموس‌تر.» با سقفِ ۱۰٫۸ دقیقه، ۱۳٪ یعنی چند جمله؛ حالا که سقف ۱۵ دقیقه
     است، جا هست. */
  EXPLAIN_PCT: 25,
  // سه جا در یک قسمت. توضیح‌دهنده‌ای که همه‌جا باشد دیگر توضیح‌دهنده نیست،
  // گویندهٔ دوم است و درس را دو برابر می‌کند.
  EXPLAIN_MAX_SPOTS: 3,
  /* کفِ طولِ یک تیکه. توضیحی که یکی دو مثالِ ملموس دارد زیر این نمی‌شود؛
     ۸۰ نویسهٔ اول یعنی یک جملهٔ تعارفی هم قبول می‌شد و همان شنیده شد.
     و اگر سهم حتی برای *یکی* کافی نباشد، هیچ — یک تیکهٔ خوب بهتر از سه
     تیکهٔ بریده است، و تیکهٔ بریده از نبودنش بدتر.

     ۲۶۰ ← ۵۰۰ (۶٫۴۳): «از این حالتِ خیلی مسخره و کوتاه در بیاد.» ۲۶۰ نویسه
     دو جمله است — همان چیزی که او شنید و مسخره خواندش. با بودجهٔ ۲۰٪ از یک
     درسِ پانزده‌دقیقه‌ای (حدودِ ۱۵۰۰ نویسه)، کفِ ۵۰۰ یعنی **سه جایگاهِ
     پُر** به‌جای پنج تیکهٔ نازک. عدد از حساب آمده، نه از حدس: با ۷۰۰ فقط
     دو جا می‌ماند و «لا‌به‌لای هر درس» بی‌معنا می‌شد. */
  /* ۶٫۵۵: «بیانِ ساده و خودمانی بسیار ضعیف و گذرا» — کف بالا رفت. ۵۰۰ نویسه
     حدودِ چهار جمله است؛ برای «تعریفِ ساده + دو مثالِ مشخص + چرا + به چه
     درد» کم است. */
  EXPLAIN_MIN_CHARS: 900,
  // بازبینیِ محتوایی: «واقعاً توضیح می‌دهد؟ مثالِ ملموس دارد؟ به همین بخش
  // ربط دارد؟» — خواستهٔ صریحِ کاربر بود و در ۶٫۲۱ جا افتاد.
  EXPLAIN_REVIEW: true,

  // ── قسمتِ مرورِ بزرگ (۶٫۲۲، بخشِ ۳۰) ──
  // «یه پادکست به صورت استثنا … همهٔ مفاهیم قسمت‌های گذشته رو اون یه نفر با
  // همون لحن و سادگی و مثال‌های بسیار ملموس بیاد توضیح بده.»
  RECAP_ENABLED: true,
  // هشت درس کفِ معناداری است: با سه چهار درس هنوز چیزی برای «مرورِ بزرگ»
  // نیست، و مرورِ زودهنگام همان قسمتی است که کسی دوباره گوش نمی‌دهد.
  RECAP_MIN_PARTS: 8,
  // سفارشی که نشود، صف را برای بقیه نمی‌بندد.
  RECAP_TRY_MAX: 3,

  /* سقفِ تیک‌های درس در جعبهٔ دامنهٔ مرور (۶٫۴۰). تخته ۲۶۴ ردیف دارد و
     این فهرست برای هر مجموعه‌ای که درسی ساخته رندر می‌شود؛ بریده‌شدنش در
     خودِ جعبه نوشته می‌شود، چون درسی که دیده نشود انگار وجود ندارد. */
  RECAP_PICK_MAX: 60,

  TTS_CHUNK_CHARS: 1100,       // حداکثر طول هر تکه متن ارسالی به TTS
  // وقتی که باید برای «یک تکهٔ صوتیِ دیگر» کنار گذاشته شود.
  // چرا: حلقهٔ صداگذاری فقط *پیش از شروعِ* هر تکه ساعت را می‌دید. اگر ساعت
  // چند ثانیه به مهلت مانده بود، تکهٔ تازه شروع می‌شد و یک فراخوانِ گفتارسازی
  // می‌تواند بیش از یک دقیقه طول بکشد — یعنی ردشدن از سقفِ شش‌دقیقه‌ایِ گوگل و
  // پیامِ «Exceeded maximum execution time». حالا تکهٔ تازه فقط وقتی شروع
  // می‌شود که وقتِ تمام‌کردنش هم باشد.
  TTS_RESERVE_MS: 110000,
  // و ادغام هم یک عملیاتِ تک‌تکه و نابخش‌پذیر است: اگر وسطش مهلت تمام شود،
  // هیچ راهی برای ادامه نیست. با سقفِ پایین‌تر، قسمت‌های بلند تکه‌تکه می‌مانند
  // (که مشکلی نیست) به‌جای اینکه کلِ اجرا کشته شود.
  MERGE_RESERVE_MS: 150000,
  SAMPLE_RATE: 24000,          // خروجی Gemini TTS: PCM 24kHz، ۱۶ بیت، تک‌کاناله
  MAX_WAV_BYTES: 10000000,     // ~۳٫۵ دقیقه در هر فایل؛ قسمت بلندتر به چند بخش نوشته می‌شود

  // پس از آماده‌شدن بخش‌ها، یک فایل یکجا هم ساخته می‌شود تا تلگرام کل قسمت را
  // در یک فایل بفرستد. سقف آپلود ربات تلگرام پنجاه مگابایت است.
  MERGE_AUDIO: true,
  // سقفِ هر فایلِ یکجا. تلگرام تا پنجاه مگابایت را می‌پذیرد، ولی محدودیتِ
  // واقعیِ ما تلگرام نیست: خودِ Apps Script است. چسباندن در حافظه انجام
  // می‌شود و رشتهٔ base64 چهار سومِ حجمِ فایل است. تجربهٔ ۱۲ مرداد: ادغامِ
  // ۳۸ مگابایت (درس‌نامه) سالم تمام شد و ادغامِ ۴۱٫۷ مگابایت (برنامهٔ متنوع،
  // هفت بخش) اجرا را کشت — بی هیچ استثنای قابلِ گرفتن و بی هیچ سطری در سیاهه.
  // پس سقف را زیرِ آن مرز می‌گذاریم: ~۱۱ دقیقه در هر فایل. قسمتِ بلندتر دو
  // فایلِ متوازن می‌شود، که از یک ادغامِ کشته‌شده بی‌نهایت بهتر است.
  // ۱۲ مرداد ۳۸ مگابایت سالم ادغام شد و ۴۱٫۷ اجرا را کشت. ۳۶ زیرِ آن مرز است
  // و همچنان حاشیه دارد — و همین ~۱٫۵ دقیقه بیشتر، مرزِ «یک فایل» را از ۱۱٫۴ به
  // ۱۲٫۵ دقیقه می‌برد که تقریباً همهٔ قسمت‌های واقعی را پوشش می‌دهد.
  MERGE_MAX_BYTES: 36000000,

  // نرخِ گفتارِ فارسیِ این گوینده: نویسه بر ثانیه. از هدفِ ۱۰ دقیقه/۱۵۰۰ واژه
  // به دست آمده (۱۵۰ واژه در دقیقه × ~۵٫۵ نویسه = ~۱۳٫۷).
  //
  // ══ این عدد «فقط یک تخمین» نبود؛ تصمیمِ یک‌فایل/دوفایل بود (۶٫۲۹) ══
  // کامنتِ پیشین می‌گفت «فقط برای تخمینِ پیش از ساخت … نه برای چیزی که باید
  // دقیق باشد». نادرست بود: `oneFileMaxChars_` تنها از همین عدد می‌آید، و
  // آن سقفْ تعیین می‌کند قسمت در یک فایل برود یا دو تا.
  //
  // اندازه‌گیریِ واقعی (قسمت ۱۹ درس‌نامه، ۲۷ اوت): ۷٬۲۹۷ نویسهٔ گفتنی →
  // ۳۶٬۱۶۱٬۶۰۴ بایت صدا = ۷۵۳ ثانیه. یعنی ۹٫۷ نویسه بر ثانیه، نه ۱۳٫۷ —
  // و با حاشیهٔ ۸ درصدی هم فرض ۱۲٫۶ بود، یعنی ۳۰٪ خوش‌بینانه. برای همین
  // *هر* قسمت دو فایل می‌شد، هر چه سقف را در جای دیگری سفت‌تر می‌کردیم.
  // حالا این فقط دانهٔ اولیه است؛ عددِ واقعی از خروجیِ خودِ قسمت‌ها می‌آید.
  //
  // ولی دانه هم باید صادق باشد: تا دو قسمتِ اول اندازه‌گیری نشوند، همین عدد
  // سقف را می‌سازد و دو شبِ دیگر هم قسمت دو فایل می‌شود. ۱۰ کمی زیرِ
  // اندازه‌گیریِ واقعی است (۹٫۷ سرتاسری، ~۱۰٫۳ اگر موسیقی را جدا حساب کنیم)
  // و سقفِ تنگ‌تر بی‌ضرر است؛ سقفِ گشاد دو فایل می‌سازد.
  SPEECH_CHARS_PER_SEC: 10,

  // ── کالیبراسیونِ اندازه‌گیری‌شده (۶٫۲۹) ──
  // پس از هر قسمت، «بایتِ صدا به ازای هر نویسهٔ متنِ گفتنی» ثبت می‌شود و
  // سقفِ یک فایل از میانهٔ همین اندازه‌گیری‌ها می‌آید، نه از یک ثابتِ حدسی.
  // میانه (نه میانگین) چون یک قسمتِ ناقص نباید سقف را جابه‌جا کند.
  SPEECH_CALIB: true,
  SPEECH_CALIB_KEEP: 8,        // چند قسمتِ اخیر نگه داشته شود
  SPEECH_CALIB_MIN: 2,         // زیرِ این شمار، هنوز به فرمولِ قدیمی تکیه می‌کنیم
  // مرزهای عقل: خارج از این بازه یعنی اندازه‌گیری خراب است، نه گوینده کند.
  SPEECH_BPC_MIN: 2000,
  SPEECH_BPC_MAX: 9000,
  // حاشیهٔ سقفِ یک فایل. ۳٫۴ ثانیه بالاتر از سقف هم «دو فایل» است، پس
  // حاشیه باید واقعی باشد نه اسمی.
  ONE_FILE_MARGIN: 0.94,

  // «یک فایلِ واحد» خواستهٔ صریحِ صاحبِ برنامه است: دو تکه، کارِ حرفه‌ای به نظر
  // نمی‌رسد. مرزش را حدس نمی‌زنیم — از همان MERGE_MAX_BYTES و نرخِ گفتار حساب
  // می‌شود (oneFileMaxChars_). قسمتی که از این بلندتر شود، ناگزیر دو فایل است.
  // ── بانکِ موسیقی و افکت (بخشِ ۲۳) ──
  // فایل‌ها در پوشه‌ای در OUTPUT می‌نشینند و فهرستشان در تبِ «موسیقی» است.
  // فقط WAV؛ رمزگشاییِ MP3 در Apps Script ممکن نیست.
  // تلاشِ دوبارهٔ تلگرام وقتی خودِ اتصال برقرار نشود (پرتابِ fetch).
  TG_ATTEMPTS: 4,

  /* ── جزوهٔ مجموعه (۵٫۸۵) ──
     خواستهٔ صاحبِ برنامه: هر مجموعه یک جزوه در پوشهٔ خودش داشته باشد که با
     هر قسمت به‌روز شود، فهرستِ کلیک‌شونده و نقشهٔ راه داشته باشد، و مثلِ
     کتاب خوانده شود نه مثلِ متنِ پادکست. بخشِ ۲۶. */
  // ── پرامپت‌ها از ریپو به درایو، خودکار (۵٫۸۵) ──
  // تا امروز نیمهٔ دومِ قاعدهٔ ۷ج را آدم انجام می‌داد. حالا مثلِ نقشهٔ پوشه،
  // از raw گیت‌هاب می‌آید — پس تنها منبعِ حقیقت ریپوست و دو نسخه نمی‌توانند
  // بی‌صدا از هم فاصله بگیرند.
  HANDOUT_TAB: 'کاربردِ جزوه',  // تاریخچه: هر به‌روزرسانیِ جزوه یک ردیف
  HANDOUT_SCAN_MAX: 25,        // چند **پوشه** پیمایش شود؛ ردِ ارزان مجانی است
  HANDOUT_SCAN_MS: 90000,      // نگهبانِ زمانِ کاوش
  HANDOUT_STUCK_DAYS: 3,       // چند روز عقب‌ماندگی تا «ایرادِ کد» شمرده شود

  /* ── دیده‌بانِ کارگرهای بیرونی (۶٫۱۱) ──
     سه کارگر بیرون از موتور کار می‌کنند و هیچ‌کدام تا ۶٫۱۰ دیده‌بان نداشتند.
     آستانه‌ها جدایند چون ریتمشان فرق دارد؛ یک آستانهٔ مشترک یا برای یکی زود
     است یا برای دیگری دیر. */
  WD_MONITOR_DAYS: 2,          // ناظرِ روزانه (Cowork، ۱۲:۰۰)
  WD_ENRICH_DAYS: 2,           // تسکِ غنی‌سازی (هر ساعت)
  WD_RENDER_DAYS: 1,           // اکشنِ رندر (GitHub، هر ساعت)
  REPEAT_ALERT: 10,            // این‌قدر یافتهٔ تکراری = حلقه بسته نمی‌شود
  HANDOUT_TRY_MAX: 4,          // چند تلاشِ ناموفق تا «رهاشده» شمرده شود
  HANDOUT_WATCH_MAX: 60,       // سقفِ مجموعه‌های زیرِ نظرِ همیشگی

  PROMPT_SYNC: true,
  PROMPT_KINDS: ['monitor', 'enrich'],
  PROMPT_SYNC_AHEAD: 3,        // چند شمارهٔ پیاپیِ نبوده تا توقف

  // ═══════════════════ انتشار در یوتیوب (بخشِ ۲۷، نسخهٔ ۵٫۹۷) ═══════════════════
  /* یوتیوب فایلِ صوتی نمی‌پذیرد؛ فقط ویدئو. و Apps Script نمی‌تواند ویدئو
     بسازد — نه ffmpeg دارد نه کتابخانه‌ای، و مهلتِ شش‌دقیقه‌ای هم اجازه نمی‌دهد.
     پس مرزِ کار این است: موتور تصمیم می‌گیرد، متن می‌نویسد، کاور می‌سازد،
     پلی‌لیست می‌چیند و آپلود می‌کند؛ ساختِ خودِ MP4 بیرون انجام می‌شود و از
     راهِ `_YT-RENDER.json` خواسته می‌شود. همان تقسیمِ کاری که برای موسیقی
     جواب داد: «تو نشانی بده، موتور می‌آورد» — این‌بار برعکس. */
  YT_ENABLED: true,
  YT_TAB: 'انتشار در یوتیوب',
  // اول unlisted، بعد وارسیِ نشتیِ خصوصی، و تازه بعدش عمومی. فاصله‌اش چند
  // ثانیه است، ولی معنایش این است که یک لینکِ درایو هرگز عمومی نمی‌شود.
  YT_PRIVACY_FIRST: 'unlisted',
  YT_PRIVACY_FINAL: 'public',
  YT_CATEGORY_VARIETY: '22',            // People & Blogs
  YT_CATEGORY_SPECIAL: '27',            // Education
  YT_LANG: 'fa',
  YT_TITLE_MAX: 100,                    // سقفِ خودِ یوتیوب
  YT_DESC_MAX: 5000,                    // سقفِ خودِ یوتیوب
  YT_TAGS_CHARS: 460,                   // سقفِ واقعی ۵۰۰ است؛ حاشیه می‌گذاریم
  /* سه در شب + یکی در دورِ ۱۰ صبح = چهار در روز. سقفِ واقعی پنج است
     (۹۰۰۰ واحد ÷ ~۱۷۵۰ برای هر قسمت)، و آن یکیِ باقی‌مانده برای پلی‌لیست و
     کاور و بازخورد کنار گذاشته می‌شود — سهمیه‌ای که وسطِ کار تمام شود، بدتر
     از سهمیه‌ای است که از اول کم برداشته شده باشد. */
  YT_MAX_PER_RUN: 3,                    // آپلود در هر اجرای شبانه
  YT_MANUAL_MAX: 6,                     // آپلود در هر فشردنِ دکمه
  YT_MS: 150000,                        // بودجهٔ زمانیِ هر اجرا
  YT_BACKFILL_WALK: 12,                 // پوشهٔ قسمت در هر کاوشِ گذشته
  YT_RENDER_FILE: '_YT-RENDER.json',
  YT_RENDER_MAX: 8,                     // بیش از این، درخواستِ رندرِ *ساخته‌نشده* انباشته نشود
  // ── نوبتِ مستقلِ یوتیوب (۶٫۳۷) ──
  // صفِ انتشار هر روز دو تا رشد می‌کند؛ کاری با این آهنگ نمی‌تواند مهمانِ
  // اجرای شبانه یا وارسیِ سلامت بماند. هر چند ساعت، با بودجهٔ خودش.
  YT_TICK_HOURS: 2,
  YT_TICK_MS: 240000,
  YT_VIDEO_MARK: 'ویدئو',               // نامِ فایلِ MP4 در پوشهٔ قسمت
  /* ── رندرِ بیرونی (۶٫۶) ──
     موتور ویدئو نمی‌سازد و هیچ سشنِ ابری‌ای هم به فایل‌های درایو دسترسیِ
     شبکه‌ای ندارد (drive.google.com از آن محیط‌ها باز نمی‌شود). پس کار به
     GitHub Actions سپرده شده: موتور صوت و کاورِ همان قسمت را موقتاً «هرکس
     با لینک: فقط دیدن» می‌کند و نشانی‌شان را در صف می‌گذارد؛ اکشن MP4 را
     می‌سازد و به‌صورتِ release asset منتشر می‌کند؛ موتور برش می‌دارد و
     اشتراک را **پس می‌گیرد**. */
  YT_QUEUE_ID: '1qerT_vwZpOTFhMXYv-J0m2cIC8Eiv8L-',  // شناسهٔ ثابتِ _YT-RENDER.json
  YT_RENDER_MAP: 'docs/renders.json',   // نقشهٔ ویدئوهای ساخته‌شده، در ریپو
  YT_SHARE_DAYS: 3,                     // بیش از این، اشتراکِ صوت پس گرفته می‌شود
  YT_COLLECT_MAX: 3,                    // چند ویدئو در هر اجرا برداشته شود
  YT_COLLECT_MS: 120000,

  /* ── بازخوردِ یوتیوب (۶٫۷) ──
     نیمهٔ دومش مهم‌تر است: عددها به پرامپتِ عنوانِ قسمتِ بعدی برمی‌گردند
     (`ytLearn_`). تحلیلی که به تصمیمی وصل نشود، در این ریپو پنج بار
     نوشته شده و پنج بار بی‌اثر مانده. */
  YT_STATS: true,
  YTS_TAB: 'بازخوردِ یوتیوب',
  YTC_TAB2: 'کامنت‌های یوتیوب',
  YT_STATS_MAX: 40,                     // تازه‌ترین ویدئوها در هر دور
  YT_COMMENTS_MAX: 8,                   // کامنتِ تازه از هر ویدئو
  YT_STATS_EVERY_H: 20,                 // فاصلهٔ دورها
  YT_STATS_MS: 60000,
  YT_LEARN_MIN: 6,                      // زیرِ این، «الگو» فقط نویز است

  /* خلاصهٔ لینک‌ها (۶٫۱۹): روزی که ویدئویی منتشر نشده، هیچ پیامی نمی‌رود. */
  // چند روز بی هیچ انتشاری، در حالی که صف خالی نیست = گیر کرده، نه بیکار.
  YT_STALL_DAYS: 2,
  YT_DIGEST: true,
  YT_DIGEST_HOURS: 26,
  YT_COVER_FOLDER: 'کاورهای یوتیوب',
  YT_COVER_CHARS: 42,                   // سقفِ متنِ روی کاور — خوانایی در اندازهٔ بندانگشتی
  YT_PLAN_FILE: '_yt.json',             // نقشهٔ انتشارِ هر قسمت، در پوشهٔ خودش
  YT_CHANNEL: true,                     // نگه‌داشتنِ شناسنامهٔ کانال
  YTC_TAB: 'شناسنامهٔ کانال یوتیوب',
  YT_WATERMARK: true,                   // واترمارک = خودِ عکسِ پروفایلِ کانال
  YT_CHANNEL_EVERY_DAYS: 7,             // وارسیِ کامل، حتی وقتی چیزی عوض نشده
  YT_TODO_EVERY_DAYS: 7,                // یادآوریِ کارهای دستی — نه هر روز
  YT_THUMB: true,
  /* تبِ Podcasts کانال از همین پر می‌شود: status.podcastStatus روی پلی‌لیست.
     (تبِ Posts هیچ منبعی در API ندارد و کارِ آدم است.) */
  YT_PODCAST: true,
  /* شکستِ پایدارِ کاور/پادکستِ پلی‌لیست (حالِ کانال، نه کد): پس از این چند
     تلاش، فقط هفته‌ای یک بار دوباره امتحان می‌شود (۶٫۵۴). */
  YT_PL_TRY_MAX: 4,
  YT_PL_RETRY_DAYS: 7,
  YT_PLAYLISTS: true,
  YT_CHAPTERS: true,
